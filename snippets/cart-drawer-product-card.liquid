{%- doc -%}
  Product card used in the empty cart drawer bestsellers carousel.

  @param {product} [product] - The product to render
  @param {string} [title] - Fallback title when no product is selected
  @param {string} [price] - Fallback formatted price
  @param {boolean} [show_badge] - Whether to show the most-loved badge
  @param {boolean} [placeholder] - Whether this is an onboarding placeholder
{%- enddoc -%}

{%- liquid
  assign card_product = product
  assign is_placeholder = placeholder | default: false, allow_false: true
  assign display_badge = show_badge | default: false, allow_false: true

  assign card_title = title
  if card_title == blank and card_product != blank
    if card_product.type != blank
      assign card_title = card_product.type
    else
      assign card_title = card_product.title
    endif
  endif

  assign card_url = blank
  assign card_image = blank
  if card_product != blank
    assign card_url = card_product.url
    assign card_image = card_product.featured_image
  endif

  assign rating_value = 5
  assign rating_count = 49
  if card_product != blank
    if card_product.metafields.reviews.rating.value.rating != blank
      assign rating_value = card_product.metafields.reviews.rating.value.rating
    endif
    if card_product.metafields.reviews.rating_count.value != blank
      assign rating_count = card_product.metafields.reviews.rating_count.value
    endif
  endif

  assign display_price = price
  if card_product != blank
    assign display_price = card_product.price | money_without_trailing_zeros
  endif

  assign variant = card_product.selected_or_first_available_variant
  assign can_add_to_cart = false
  if variant and variant.available
    assign can_add_to_cart = true
  endif

  assign product_form_id = 'CartDrawer-ProductForm-' | append: card_product.id
  assign add_to_cart_label = 'actions.add_to_cart' | t
-%}

<div class="cart-drawer-card">
  <a
    class="cart-drawer-card__media-link"
    {% if card_url != blank %}
      href="{{ card_url }}"
    {% else %}
      role="link"
      aria-disabled="true"
    {% endif %}
  >
    <div class="cart-drawer-card__media">
      {%- if display_badge -%}
        <span class="cart-drawer-card__badge">
          <span class="cart-drawer-card__badge-icon" aria-hidden="true">
            {{ 'featured-prints-badge-heart.svg' | inline_asset_content }}
          </span>
          <span class="cart-drawer-card__badge-label">{{ 'content.most_loved' | t }}</span>
        </span>
      {%- endif -%}

      {%- if card_image != blank -%}
        {{
          card_image
          | image_url: width: 600
          | image_tag:
            class: 'cart-drawer-card__image',
            loading: 'lazy',
            widths: '240, 360, 480, 600',
            sizes: '240px',
            alt: card_title
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'cart-drawer-card__image cart-drawer-card__image--placeholder' }}
      {%- endif -%}
    </div>
  </a>

  <div class="cart-drawer-card__meta">
    <h3 class="cart-drawer-card__title">
      {%- if card_url != blank -%}
        <a href="{{ card_url }}">{{ card_title }}</a>
      {%- else -%}
        {{ card_title }}
      {%- endif -%}
    </h3>

    <div
      class="cart-drawer-card__rating"
      aria-label="{{ rating_value }} out of 5 stars, {{ rating_count }} reviews"
    >
      <div class="cart-drawer-card__stars" aria-hidden="true">
        {%- for i in (1..5) -%}
          <span class="cart-drawer-card__star">
            {{ 'featured-prints-star.svg' | inline_asset_content }}
          </span>
        {%- endfor -%}
      </div>
      <span class="cart-drawer-card__rating-count">({{ rating_count }})</span>
    </div>

    <p class="cart-drawer-card__price">{{ display_price }}</p>
  </div>

  {%- if is_placeholder or card_product == blank -%}
    <button
      class="button cart-drawer-card__atc"
      type="button"
      disabled
    >
      <span class="button-text">{{ 'actions.add_to_cart' | t }}</span>
    </button>
  {%- else -%}
    <product-form-component
      class="cart-drawer-card__form"
      data-product-id="{{ card_product.id }}"
      data-product-url="{{ card_product.url }}"
      on:submit="/handleSubmit"
    >
      {%- form 'product', card_product, id: product_form_id, data-type: 'add-to-cart-form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ variant.id }}"
          {% unless can_add_to_cart %}
            disabled
          {% endunless %}
        >
        <input
          type="hidden"
          name="quantity"
          value="{{ variant.quantity_rule.min | default: 1 }}"
        >
        {% render 'add-to-cart-button',
          add_to_cart_text: add_to_cart_label,
          class: 'cart-drawer-card__atc add-to-cart-button',
          can_add_to_cart: can_add_to_cart,
          show_icon: false,
          product: card_product
        %}
      {%- endform -%}
    </product-form-component>
  {%- endif -%}
</div>
