{%- doc -%}
  Loads the cart rewards controller that auto-adds and auto-removes the
  gift card once the gift-card spend threshold is reached. The 15% reward
  is an automatic Shopify discount and is not added as a product.

  @example
    {% render 'cart-rewards-controller' %}
{%- enddoc -%}

{%- if settings.cart_free_shipping_enabled -%}
  <script
    src="{{ 'cart-rewards.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  {%- liquid
    assign gift_product = settings.cart_reward_gift_product
    assign gift_variant = gift_product.selected_or_first_available_variant
    assign gift_threshold_cents = settings.cart_reward_secret_threshold | default: 500 | times: 100
  -%}

  {%- if gift_product != blank and gift_threshold_cents > 0 -%}
    <cart-rewards-controller hidden>
      <script type="application/json">
        [
          {
            "key": "gift",
            "productId": {{ gift_product.id | json }},
            "variantId": {{ gift_variant.id | default: 0 | json }},
            "threshold": {{ gift_threshold_cents | json }}
          }
        ]
      </script>
    </cart-rewards-controller>
  {%- endif -%}
{%- endif -%}
