{%- doc -%}
  Variant picker styles consolidated into a single snippet for reliable CSS subsetting.
  Rendered from both the variant-main-picker snippet (product pages, where the picker
  originally renders) and from the product-card-related blocks and sections that can
  spawn a quick-add modal (collection/search pages), so the dropdown variant picker
  styles are available when the quick-add modal injects a variant picker via fetched
  product page HTML.

  @example
  {% render 'variant-picker-styles' %}
{%- enddoc -%}

{% stylesheet %}
  /* Variant picker container styles - unique to main variant picker */
  .variant-picker {
    width: 100%;
  }

  .variant-picker__form {
    width: 100%;
  }

  .variant-picker[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  /* Dropdown variant option styles */
  .variant-option__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-variant-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    margin-top: var(--margin-2xs);
    overflow: clip;
    color: var(--color-variant-text);
  }

  .variant-option__select-wrapper:has(.swatch) {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;
  }

  .variant-option__select-wrapper:hover {
    border-color: var(--color-variant-hover-border);
    color: var(--color-variant-hover-text);
  }

  .variant-option__select-wrapper:hover .variant-option__select {
    background-color: var(--color-variant-hover-background);
  }

  .variant-option__select:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-option__select {
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-2xs));
    appearance: none;
    background-color: var(--color-variant-background);
    color: inherit;
    border: 0;
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .variant-option__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .variant-option__select--has-swatch {
    padding-inline-start: calc((2 * var(--padding-sm)) + var(--variant-picker-swatch-width));
  }

  .variant-option__select-wrapper .swatch {
    position: absolute;
    top: 50%;
    left: var(--padding-md);
    transform: translateY(-50%);
  }

  /* Variant picker alignment modifiers */
  .variant-picker--center,
  .variant-picker--center .variant-option {
    text-align: center;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .variant-picker--right,
  .variant-picker--right .variant-option {
    text-align: right;
    justify-content: right;
  }

  .variant-picker--described .variant-picker__form {
    counter-reset: vp-step;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .variant-picker--described .variant-picker__form {
      gap: 1.375rem;
    }
  }

  .variant-option.variant-option--buttons.variant-option--described {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 0.625rem;
    row-gap: 0.75rem;
    width: 100%;
    overflow: visible;
  }

  .variant-option.variant-option--finish-native {
    display: none;
  }

  .variant-option.variant-option--buttons.variant-option--described[hidden],
  .variant-picker--described:not(:has(.variant-option--format input:checked[data-option-handle*='framed']))
    .variant-option--finish {
    display: none;
  }

  .variant-option.variant-option--buttons.variant-option--described[hidden] > legend {
    counter-increment: none;
  }

  .variant-option--described + .variant-option--described {
    margin-top: 0;
  }

  .variant-option.variant-option--buttons.variant-option--described > legend {
    counter-increment: vp-step;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    grid-column: 1 / -1;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    float: none;
    padding: 0;
    margin: 0 0 0.25rem;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.375;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--vp-brand, #321c41);
  }

  .variant-option__legend-heading {
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  .variant-option__legend-heading::before {
    content: counter(vp-step) '.';
    flex-shrink: 0;
  }

  .variant-option__legend-text {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .variant-option.variant-option--buttons.variant-option--described > legend::before {
    content: none;
  }

  @media screen and (min-width: 750px) {
    .variant-option.variant-option--buttons.variant-option--described > legend {
      font-size: 1rem;
      line-height: 1.375;
    }
  }

  .variant-option__size-guide {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    flex: 0 0 auto;
    gap: 0.375rem;
    min-width: 0;
    margin: 0;
    color: var(--vp-link, #3b61ba);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    white-space: nowrap;
  }

  .variant-option__size-guide-icon {
    display: block;
    width: 0.9154rem;
    height: 0.9154rem;
    overflow: clip;
    flex-shrink: 0;
  }

  .variant-option__size-guide-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .variant-option__size-guide {
      gap: 0.625rem;
      font-size: 0.875rem;
      line-height: 1.25;
    }
  }

  .variant-option.variant-option--buttons.variant-option--described .variant-option__button-label,
  .variant-option.variant-option--buttons.variant-option--described .variant-option__button-label:hover,
  .variant-option.variant-option--buttons.variant-option--described .variant-option__button-label:hover:has([aria-disabled='true']):has([data-option-available='false']) {
    grid-column: 1 / -1;
    flex: none;
    width: 100%;
    min-width: 0;
    min-height: 0;
    white-space: normal;
    justify-content: flex-start;
    align-items: stretch;
    gap: 0;
    padding: 1rem;
    border: 2px solid var(--vp-border, #e8dff1);
    border-radius: 0.75rem;
    background-color: var(--vp-card-bg, #fffefd);
    color: var(--vp-text, #242027);
    overflow: visible;
    box-shadow: none;
  }

  .variant-option--described .variant-option__button-label::before,
  .variant-option--described .variant-option__button-label::after {
    content: none;
  }

  .variant-option.variant-option--buttons.variant-option--described .variant-option__button-label:has(:checked),
  .variant-option.variant-option--buttons.variant-option--described .variant-option__button-label:has(:checked):hover {
    border-width: 2px;
    border-color: var(--vp-accent, #8855aa);
    background-color: var(--vp-card-bg, #fffefd);
    color: var(--vp-text, #242027);
  }

  .variant-option--described .variant-option__button-label--badged {
    margin-top: 0.4375rem;
    padding-top: 1.3125rem;
  }

  .variant-option--described .variant-option__card-badge {
    position: absolute;
    top: -0.75rem;
    left: 1rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.5625rem;
    padding: 0.125rem 0.75rem;
    border-radius: 1.25rem;
    background-color: var(--vp-badge, #f5cd72);
    color: var(--vp-text, #242027);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
    white-space: nowrap;
    pointer-events: none;
  }

  .variant-option--described .variant-option__card {
    display: flex;
    align-items: center;
    gap: 0;
    width: 100%;
    pointer-events: none;
    z-index: 2;
  }

  .variant-option--described.variant-option--size .variant-option__card {
    gap: 0.625rem;
  }

  .variant-option--described .variant-option__card-media {
    display: block;
    width: 3rem;
    height: 3rem;
    overflow: clip;
    border-radius: 0.125rem;
    flex-shrink: 0;
  }

  .variant-option--described .variant-option__card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .variant-option--described .variant-option__card-copy {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
    flex: 1 1 auto;
    gap: 0;
  }

  .variant-option--described .variant-option__card-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
  }

  .variant-option--described .variant-option__card-title,
  .variant-option--described .variant-option__card-price {
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.375;
    letter-spacing: 0;
    text-transform: none;
  }

  .variant-option--described .variant-option__card-title {
    color: var(--vp-text, #242027);
    min-width: 0;
  }

  .variant-option--described .variant-option__card-price {
    color: var(--vp-brand, #321c41);
    flex-shrink: 0;
  }

  .variant-option--described .variant-option__card-desc,
  .variant-option--described .variant-option__card-compare {
    font-family: var(--font-body--family);
    font-weight: 400;
    color: var(--vp-muted, #605c64);
  }

  .variant-option--described .variant-option__card-desc {
    font-size: 0.8125rem;
    line-height: 1.23;
    min-width: 0;
  }

  .variant-option--described .variant-option__card-compare {
    font-size: 0.875rem;
    line-height: 1.2;
    text-decoration: line-through;
    flex-shrink: 0;
  }

  .variant-option--described .variant-option__card-radio {
    display: none;
  }

  .variant-option--described.variant-option--size .variant-option__card-radio {
    display: block;
    box-sizing: border-box;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    border: 1.5px solid var(--vp-border, #e8dff1);
    border-radius: 99px;
    background-color: var(--vp-card-bg, #fffefd);
    position: relative;
  }

  .variant-option--described.variant-option--size
    .variant-option__button-label:has(:checked)
    .variant-option__card-radio::after {
    content: '';
    position: absolute;
    inset: 0.25rem;
    border-radius: 99px;
    background-color: var(--vp-accent, #8855aa);
  }

  .variant-option--described .variant-option__strikethrough {
    display: none;
  }

  .variant-option--described.variant-option--size .variant-option__button-label[hidden],
  .variant-picker--described:has(.variant-option--format input:checked[data-option-handle*='digital'])
    .variant-option--size
    .variant-option__button-label:not(:has(input[data-option-handle*='digital'])),
  .variant-picker--described:has(.variant-option--format input:checked:not([data-option-handle*='digital']))
    .variant-option--size
    .variant-option__button-label:has(input[data-option-handle*='digital']) {
    display: none;
  }

  .variant-option.variant-option--buttons.variant-option--described.variant-option--finish {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 0.5rem;
    row-gap: 0.5rem;
    align-items: start;
  }

  .variant-option.variant-option--buttons.variant-option--described.variant-option--finish > legend {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 1rem;
    line-height: 1.25;
    align-items: center;
  }

  .variant-option--described.variant-option--finish .variant-option__legend-text {
    overflow: visible;
    text-overflow: unset;
  }

  .variant-option--described.variant-option--finish .variant-option__size-guide {
    gap: 0.3125rem;
    font-size: 0.875rem;
    line-height: 1.25;
  }

  .variant-option.variant-option--buttons.variant-option--described.variant-option--finish .variant-option__button-label,
  .variant-option.variant-option--buttons.variant-option--described.variant-option--finish .variant-option__button-label:hover,
  .variant-option.variant-option--buttons.variant-option--described.variant-option--finish
    .variant-option__button-label:hover:has([aria-disabled='true']):has([data-option-available='false']) {
    box-sizing: border-box;
    grid-column: auto;
    display: flex;
    flex: none;
    width: 100%;
    min-width: 0;
    height: 2.5rem;
    min-height: 2.5rem;
    max-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid #d9d6db;
    border-radius: 0.3125rem;
    background-color: #fff;
    color: var(--vp-text, #242027);
    justify-content: center;
    align-items: center;
    overflow: hidden;
    white-space: nowrap;
    box-shadow: none;
  }

  .variant-option.variant-option--buttons.variant-option--described.variant-option--finish
    .variant-option__button-label:has(:checked),
  .variant-option.variant-option--buttons.variant-option--described.variant-option--finish
    .variant-option__button-label:has(:checked):hover {
    border-color: var(--vp-accent, #8855aa);
    background-color: #fff;
    box-shadow: inset 0 0 0 1px var(--vp-accent, #8855aa);
  }

  .variant-option--described.variant-option--finish .variant-option__card-title {
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.375;
    letter-spacing: 0;
    text-align: center;
    text-transform: none;
    color: var(--vp-text, #242027);
  }

  .variant-option.variant-option--buttons.variant-option--described.variant-option--finish
    .variant-option__button-label[hidden],
  .variant-option.variant-option--buttons.variant-option--described.variant-option--finish
    .variant-option__button-label:has([data-option-handle*='none']),
  .variant-option.variant-option--buttons.variant-option--described.variant-option--finish
    .variant-option__button-label:has([data-option-handle*='unframed']),
  .variant-option.variant-option--buttons.variant-option--described.variant-option--finish
    .variant-option__button-label:has([data-option-handle*='no-frame']) {
    display: none;
  }
{% endstylesheet %}
