{%- doc -%}
  Custom-artwork PDP styles: gallery layout and buy button treatment.
{%- enddoc -%}

{% stylesheet %}
  custom-artwork-pdp {
    display: contents;
  }

  custom-artwork-pdp .buy-buttons-block .add-to-cart-button {
    display: none;
  }

  custom-artwork-pdp .pdp-buy-now {
    flex: 1 1 100%;
  }

  custom-artwork-pdp .pdp-buy-now__button {
    width: 100%;
    background: #321c41;
    color: #fefefd;
    border-color: #321c41;
  }

  @media screen and (min-width: 750px) {
    custom-artwork-pdp .product-information slideshow-controls {
      display: none;
    }

    custom-artwork-pdp
      .product-information
      .media-gallery--carousel
      slideshow-component:has(slideshow-controls[thumbnails]) {
      grid-template-columns: minmax(0, 1fr);
      column-gap: 0;
    }
  }
{% endstylesheet %}
