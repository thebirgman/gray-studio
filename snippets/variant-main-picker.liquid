{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  Format/Size card copy (description, badge, optional image) comes from global
  `option_card` metaobjects: `metaobjects.option_card.values`, matched by
  option_value, handle, or aliases. Prices and Size "Save" stay on the variant.

  @param {object} product_resource - The product object.
  @param {object} [block] - The variant picker block object.
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% liquid
  # Custom styling applies to:
  #   - dropdowns + buttons when variant_style_class == 'custom' (unselected colors)
  #   - buttons only when selected_variant_style_class == 'custom' (selected colors)
  # The 'buttons' label is kept for backwards-compat of the class name.
  assign has_custom_variant_buttons = false
  if block_settings.variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  if block_settings.variant_style == 'buttons' and block_settings.selected_variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  assign fieldset_index = 0
%}

{% unless product_resource.has_only_default_variant %}
  {% liquid
    assign default_variant = product_resource.selected_or_first_available_variant
    assign metafield_descriptions = product_resource.metafields.custom.option_descriptions.value
    assign option_cards = metaobjects.option_card.values
    assign show_option_descriptions = false
    if block_settings.show_option_descriptions
      assign show_option_descriptions = true
    endif
  %}
  {% if has_custom_variant_buttons %}
    {% render 'variant-button-custom-styles', block_settings: block_settings, block_id: block.id %}
  {% endif %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}{% if show_option_descriptions %} variant-picker--described{% endif %}{% if has_custom_variant_buttons %} variant-picker--custom-{{ block.id }}{% endif %}"
    style="
      {% render 'spacing-style', settings: block_settings %}
       {% if block_settings.option_label_text_color != blank %}
        --variant-option-label-color: rgba({{ block_settings.option_label_text_color.rgba }});
        --variant-option-label-color-subdued: rgba({{ block_settings.option_label_text_color.rgb }} / var(--opacity-subdued-text));
      {% endif %}
      --vp-brand: #321c41;
      --vp-accent: #8855aa;
      --vp-text: #242027;
      --vp-muted: #605c64;
      --vp-border: #e8dff1;
      --vp-card-bg: #fffefd;
      --vp-link: #3b61ba;
      --vp-badge: #f5cd72;
    "
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-handle="{{ product_resource.handle }}"
    data-product-title="{{ product_resource.title | escape }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif

          assign option_handle = product_option.name | handleize
          assign described_layout = ''
          assign is_finish_option = false
          if option_handle == 'finish' or option_handle contains 'finish'
            assign is_finish_option = true
          elsif option_handle contains 'frame'
            unless option_handle contains 'format'
              assign is_finish_option = true
            endunless
          endif
          if show_option_descriptions and block_settings.variant_style == 'buttons'
            assign described_layout = 'cards'
            if option_handle == 'size' or option_handle contains 'size'
              assign described_layout = 'size'
            elsif option_handle == 'format' or option_handle contains 'format' or option_handle contains 'print'
              assign described_layout = 'format'
            endif
          endif
        -%}

        {%- if is_finish_option -%}
          {%- liquid
            assign default_option_index = product_option.position | minus: 1
            assign default_value_at_position = default_variant.options[default_option_index]
          -%}
          <fieldset
            class="variant-option variant-option--finish-native"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            hidden
          >
            {%- for product_option_value in product_option.values -%}
              {%- liquid
                if product_option_value.name == default_value_at_position
                  assign is_selected_default = true
                else
                  assign is_selected_default = false
                endif
                assign value_handle = product_option_value.name | handleize
              -%}
              <input
                type="radio"
                name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                value="{{ product_option_value | escape }}"
                data-previous-checked="false"
                data-fieldset-index="{{ fieldset_index }}"
                data-input-index="{{ forloop.index0 }}"
                data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                data-option-name="{{ product_option.name | escape }}"
                data-option-handle="{{ value_handle }}"
                data-option-value-id="{{ product_option_value.id }}"
                data-option-available="{{ product_option_value.available }}"
                data-connected-product-url="{{ product_option_value.product_url }}"
                {% if product_option_value.variant.id %}
                  data-variant-id="{{ product_option_value.variant.id }}"
                {% endif %}
                {% if is_selected_default %}
                  data-current-checked="true"
                  checked
                {% else %}
                  data-current-checked="false"
                {% endif %}
              >
            {%- endfor -%}
          </fieldset>
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
        {%- elsif product_option.values.size == 1 and variant_style != 'swatch' and described_layout == blank -%}
          <div
            class="variant-option"
            data-testid="variant-option-single"
          >
            {{- product_option.name | escape -}}
            <span
              class="variant-option__swatch-value"
              data-testid="variant-option-single-value"
            >
              {{- product_option.selected_value -}}
            </span>
          </div>
        {%- elsif variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          {%- liquid
            assign default_option_index = product_option.position | minus: 1
            assign default_value_at_position = default_variant.options[default_option_index]
            assign hide_finish_axis = false
            if described_layout == 'finish'
              assign selected_format_is_framed = false
              assign selected_format_is_digital = false
              for option in product_resource.options_with_values
                assign format_handle = option.name | handleize
                if format_handle == 'format' or format_handle contains 'format' or format_handle contains 'print'
                  assign format_value_handle = option.selected_value | handleize
                  if format_value_handle contains 'digital'
                    assign selected_format_is_digital = true
                  elsif format_value_handle contains 'framed'
                    unless format_value_handle contains 'unframed'
                      assign selected_format_is_framed = true
                    endunless
                  endif
                endif
              endfor
              if selected_format_is_digital or selected_format_is_framed == false
                assign hide_finish_axis = true
              endif
            endif
            assign show_option_guide = false
            assign guide_label = ''
            assign guide_link = ''
            if described_layout == 'size'
              assign guide_label = block_settings.size_guide_label | default: 'Size guide'
              assign guide_link = block_settings.size_guide_link | default: '#sizing-guide'
              assign show_option_guide = true
            elsif described_layout == 'finish'
              assign guide_label = block_settings.frame_guide_label | default: 'Frame guide'
              assign guide_link = block_settings.frame_guide_link | default: '#frame-guide'
              assign show_option_guide = true
            endif
          -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% elsif described_layout != blank %} variant-option--described variant-option--{{ described_layout }}{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {% if hide_finish_axis %}
              hidden
            {% endif %}
            {{ option_id_attribute }}
          >
            <legend>
              {%- if described_layout != blank -%}
                <span class="variant-option__legend-heading">
                  <span class="variant-option__legend-text">
                    {%- if described_layout == 'size' -%}
                      Choose a size (prior to framing)
                    {%- elsif described_layout == 'finish' -%}
                      Frame finish
                    {%- else -%}
                      Choose a {{ product_option.name | downcase | escape }}
                    {%- endif -%}
                  </span>
                </span>
                {%- if show_option_guide and guide_label != blank -%}
                    <a
                      class="variant-option__size-guide"
                      href="{{ guide_link }}"
                    >
                      <span class="variant-option__size-guide-icon" aria-hidden="true">
                        {{ 'variant-size-guide.svg' | inline_asset_content }}
                      </span>
                      <span class="variant-option__size-guide-label">{{ guide_label | escape }}</span>
                    </a>
                {%- endif -%}
              {%- else -%}
                {{ product_option.name | escape -}}
                {%- if variant_style == 'swatch' -%}
                  <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
                {%- endif %}
              {%- endif -%}
            </legend>
            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}
              {%- liquid
                if product_option_value.name == default_value_at_position
                  assign is_selected_default = true
                else
                  assign is_selected_default = false
                endif

                assign option_description = blank
                assign option_thumb = blank
                assign option_badge = blank
                assign option_variant = product_option_value.variant
                assign option_price = blank
                assign option_compare = blank
                assign option_save = 0
                assign value_handle = product_option_value.name | handleize
                assign value_name = product_option_value.name | strip
                assign is_pairing_value = false
                if described_layout == 'size' and value_handle contains 'digital'
                  assign is_pairing_value = true
                endif
                if described_layout == 'finish'
                  if value_handle contains 'none' or value_handle contains 'unframed' or value_handle == 'n-a' or value_handle contains 'no-frame'
                    assign is_pairing_value = true
                  endif
                endif
                assign option_selectable = product_option_value.available
                assign format_fallback_variant = blank
                if described_layout == 'format' or described_layout == 'cards'
                  assign option_variant = blank
                  assign option_selectable = false
                  for v in product_resource.variants
                    assign format_match = false
                    assign v_option1 = v.option1 | strip
                    assign v_option2 = v.option2 | strip
                    assign v_option3 = v.option3 | strip
                    if v_option1 == value_name or v_option2 == value_name or v_option3 == value_name
                      assign format_match = true
                    endif
                    if format_match == false
                      assign v_handle1 = v.option1 | handleize
                      assign v_handle2 = v.option2 | handleize
                      assign v_handle3 = v.option3 | handleize
                      if v_handle1 == value_handle or v_handle2 == value_handle or v_handle3 == value_handle
                        assign format_match = true
                      endif
                    endif
                    if format_match
                      if v.available
                        assign option_selectable = true
                      endif
                      if format_fallback_variant == blank
                        assign format_fallback_variant = v
                      elsif v.available and format_fallback_variant.available == false
                        assign format_fallback_variant = v
                      elsif v.available == format_fallback_variant.available and v.price < format_fallback_variant.price
                        assign format_fallback_variant = v
                      endif
                    endif
                  endfor
                  if format_fallback_variant != blank
                    assign option_variant = format_fallback_variant
                  endif
                endif
                if option_variant != blank
                  assign option_price = option_variant.price
                  assign option_compare = option_variant.compare_at_price
                  if option_compare > option_price
                    assign option_save = option_compare | minus: option_price
                  endif
                endif
                if described_layout != blank
                  assign option_card_matched = false
                  assign value_match = product_option_value.name | strip | downcase
                  if option_cards != blank
                    for card in option_cards
                      assign card_value = card.option_value.value | strip
                      assign card_value_handle = card_value | handleize
                      assign card_value_match = card_value | downcase
                      assign card_handle = card.system.handle
                      if card_handle == value_handle or card_value_handle == value_handle or card_value_match == value_match
                        assign option_card_matched = true
                      endif
                      if option_card_matched == false and card.aliases.value != blank
                        assign alias_list = card.aliases.value | split: ','
                        for alias in alias_list
                          assign alias_handle = alias | strip | handleize
                          assign alias_match = alias | strip | downcase
                          if alias_handle == value_handle or alias_match == value_match
                            assign option_card_matched = true
                          endif
                        endfor
                      endif
                      if option_card_matched
                        assign option_description = card.description.value
                        assign option_badge = card.badge.value
                        if card.image.value != blank
                          assign option_thumb = card.image.value
                        endif
                        break
                      endif
                    endfor
                  endif
                  unless option_card_matched
                    if described_layout == 'format' or described_layout == 'cards'
                      if value_handle == 'digital-download' or value_handle contains 'digital-download'
                        assign option_description = 'High-res file, delivered in minutes'
                      elsif value_handle == 'watercolour-poster' or value_handle == 'watercolor-poster' or value_handle contains 'watercolour' or value_handle contains 'watercolor'
                        assign option_description = 'Fine art matte paper, ships in 3–7 days'
                      elsif value_handle == 'giclee-canvas' or value_handle contains 'giclee'
                        assign option_description = 'Gallery-wrapped, ships in 3–7 days'
                        assign option_badge = 'Most loved'
                      elsif value_handle == 'framed-canvas' or value_handle contains 'framed-canvas' or value_handle contains 'framed'
                        assign option_description = 'Canvas + wood frame, ships in 3–7 days'
                      endif
                    elsif described_layout == 'size'
                      if value_handle contains 'medium' and value_handle contains '24'
                        assign option_badge = 'Most loved'
                      elsif value_handle contains 'large' and value_handle contains '32'
                        assign option_badge = 'Best value'
                      endif
                    endif
                    if metafield_descriptions != blank
                      assign metafield_description = metafield_descriptions[product_option_value.name]
                      if metafield_description == blank
                        assign metafield_description = metafield_descriptions[value_handle]
                      endif
                      if metafield_description != blank
                        assign option_description = metafield_description
                      endif
                    endif
                  endunless
                  if block != blank
                    for desc_block in block.blocks
                      if desc_block.type == '_option-description' or desc_block.type == 'option_description'
                        assign desc_handle = desc_block.settings.option_value | strip | handleize
                        assign desc_match = desc_block.settings.option_value | strip | downcase
                        if desc_handle == value_handle or desc_match == value_match
                          if desc_block.settings.description != blank
                            assign option_description = desc_block.settings.description
                          endif
                          if desc_block.settings.badge != blank
                            assign option_badge = desc_block.settings.badge
                          endif
                          if desc_block.settings.image != blank
                            assign option_thumb = desc_block.settings.image
                          endif
                        endif
                      endif
                    endfor
                  endif
                  if described_layout == 'finish'
                    assign option_badge = blank
                    assign option_description = blank
                    assign option_thumb = blank
                    assign option_price = blank
                    assign option_compare = blank
                    assign option_save = 0
                  endif
                endif
              -%}
              <label
                class="variant-option__button-label{% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}{% if described_layout != blank %} variant-option__button-label--described{% endif %}{% if option_badge != blank %} variant-option__button-label--badged{% endif %}"
                {% if is_pairing_value %}
                  hidden
                {% endif %}
              >
                <input
                  type="radio"
                  name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                  value="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value.name | escape }}{% if option_description != blank %} — {{ option_description | escape }}{% endif %}{% if option_selectable == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                  {% if option_selectable == false %}
                    aria-disabled="true"
                  {% endif %}
                  data-previous-checked="false"
                  data-fieldset-index="{{ fieldset_index }}"
                  data-input-index="{{ forloop.index0 }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-name="{{ product_option.name | escape }}"
                  data-option-handle="{{ value_handle }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-option-available="{{ option_selectable }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if product_option_value.variant.id %}
                    data-variant-id="{{ product_option_value.variant.id }}"
                  {% endif %}
                  {% if is_selected_default %}
                    data-current-checked="true"
                    checked
                  {% else %}
                    data-current-checked="false"
                  {% endif %}
                >
                {% if variant_style == 'swatch' %}
                  {% liquid
                    assign featured_media = product_option_value.variant.featured_media

                    # If the variant has no featured media, and we have a combined listing product, then fall back to
                    # using the featured media of the child product that is linked to this option value.
                    if featured_media == blank and product_option_value.product_url
                      assign featured_media = product_option_value.variant.product.featured_media
                    endif
                  %}

                  {% render 'swatch',
                    swatch: product_option_value.swatch,
                    variant_image: featured_media,
                    mode: 'unscaled'
                  %}
                {% elsif described_layout == 'finish' %}
                  <span
                    class="variant-option__card-title"
                    data-key="variant-option-text"
                  >
                    {{- product_option_value | escape -}}
                  </span>
                {% elsif described_layout != blank %}
                  {%- if option_badge != blank -%}
                    <span class="variant-option__card-badge">{{ option_badge | escape }}</span>
                  {%- endif -%}
                  <span class="variant-option__card">
                    <span class="variant-option__card-radio" aria-hidden="true"></span>
                    {%- if option_thumb != blank -%}
                      <span class="variant-option__card-media">
                        {{
                          option_thumb
                          | image_url: width: 160
                          | image_tag:
                            class: 'variant-option__card-image',
                            loading: 'lazy',
                            widths: '80, 120, 160',
                            sizes: '48px',
                            alt: ''
                        }}
                      </span>
                    {%- endif -%}
                    <span class="variant-option__card-copy">
                      <span class="variant-option__card-row">
                        <span
                          class="variant-option__card-title"
                          data-key="variant-option-text"
                        >
                          {{- product_option_value | escape -}}
                        </span>
                        {%- if described_layout != 'finish' and option_price != blank or described_layout == 'format' or described_layout == 'cards' -%}
                          <span class="variant-option__card-price">
                            {%- if option_price != blank -%}
                              {{- option_price | money_without_trailing_zeros -}}
                            {%- endif -%}
                          </span>
                        {%- endif -%}
                      </span>
                      {%- if described_layout == 'size' and option_save > 0 -%}
                        <span class="variant-option__card-row variant-option__card-row--meta">
                          <span class="variant-option__card-desc">Save {{ option_save | money_without_trailing_zeros }}</span>
                          <s class="variant-option__card-compare">{{ option_compare | money_without_trailing_zeros }}</s>
                        </span>
                      {%- elsif option_description != blank -%}
                        <span class="variant-option__card-row variant-option__card-row--meta">
                          <span class="variant-option__card-desc">{{ option_description | escape }}</span>
                        </span>
                      {%- endif -%}
                    </span>
                  </span>
                {% else %}
                  {% if product_option_value.available == true %}
                    <span
                      class="variant-option__button-label__pill"
                      data-key="variant-option-pill"
                    ></span>
                  {% endif %}
                  <span
                    class="variant-option__button-label__text"
                    data-key="variant-option-text"
                  >
                    {{- product_option_value | escape -}}
                  </span>
                {% endif %}
                {%- if described_layout == blank -%}
                  {% render 'strikethrough-variant', product_option: product_option_value %}
                {%- endif -%}
              </label>
            {%- endfor -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.65 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {%
            # There is an opportunity to build a custom select component that will allow us to style the select element further (animation for dropdown, swatches shown in the dropdown options, etc)
            # It's too bad as it mean rebuilding baked in behaviours but I think we've already done that for the locale selectors
            # in dawn. So it might mean more time spent in setting it up but worth it for future updates/styling.
          %}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              # (original width / original height) x new height (20px at the moment) = new width
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          {%- liquid
            assign default_option_index = product_option.position | minus: 1
            assign default_value_at_position = default_variant.options[default_option_index]
          -%}
          <div class="variant-option variant-option--dropdowns">
            <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  {%- liquid
                    if product_option_value.name == default_value_at_position
                      assign is_selected_default = true
                    else
                      assign is_selected_default = false
                    endif
                  -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if is_selected_default %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- if block_settings.variant_style == 'buttons' -%}
        {% render 'pdp-frame-finish',
          product_resource: product_resource,
          section: section,
          block: block
        %}
      {%- endif -%}

      <script type="application/json">
        {{ default_variant | json }}
      </script>
      {%- comment -%}
        Full variants table for client-side availability recomputation. Shopify's
        server-side `option_value.available` is unreliable for some selection
        paths (e.g. selecting a variant whose option-1 has no matching variant
        for the currently-selected option-2 leaves the option-1 marked
        available). The client recomputes from this table after every change.
      {%- endcomment -%}
      <script type="application/json" data-all-variants>
        [
          {%- for v in product_resource.variants -%}
            {"id":{{ v.id | json }},"available":{{ v.available | json }},"options":{{ v.options | json }},"price":{{ v.price | json }},"price_label":{{ v.price | money_without_trailing_zeros | json }}}
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      </script>
    </form>
  </variant-picker>
{% endunless %}

{% render 'variant-picker-styles' %}
