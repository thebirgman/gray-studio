{% doc %}
  Stores a short description and optional thumbnail for one product option value.

  Nested block settings are not readable from the variant picker snippet, so this
  block prints a hidden payload the picker parses into card copy and frame swatches.

  @example
  {% content_for 'block', type: '_option-description', id: 'desc-digital' %}
{% enddoc %}

{%- liquid
  assign row_value = block.settings.option_value | strip | replace: '[[', ''
  assign row_description = block.settings.description | strip | strip_newlines | replace: '[[', ''
  assign row_badge = block.settings.badge | strip | replace: '[[', ''
  assign row_scope = block.settings.format_scope | default: 'any' | strip
  assign row_image = ''
  if block.settings.image != blank
    assign row_image = block.settings.image | image_url: width: 240
  endif
-%}
<div
  class="pdp-option-asset"
  {{ block.shopify_attributes }}
  aria-hidden="true"
  data-option-value="{{ row_value | escape }}"
  data-format-scope="{{ row_scope | escape }}"
  {% if row_image != blank %}
    data-image="{{ row_image | escape }}"
  {% endif %}
>
  [[GS]]{{ row_value }}[[F]]{{ row_description }}[[F]]{{ row_badge }}[[F]]{{ row_scope }}[[F]]{{ row_image }}[[/GS]]
</div>

{% schema %}
{
  "name": "Option description",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "option_value",
      "label": "Option value",
      "info": "Must match the variant option name exactly, e.g. Digital Download or Small - 12x16\"."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "info": "Shown under the option name on Format cards. Size cards use a computed Save amount when the variant is on sale."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "info": "Optional pill on the card, e.g. Most loved or Best value."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Optional thumbnail",
      "info": "For Format cards or Frame swatches. Use Gelato frame photography for finishes."
    },
    {
      "type": "select",
      "id": "format_scope",
      "label": "Frame image applies to",
      "info": "Only used for Frame finishes. Upload separate paper vs canvas (floater) photos when the same finish name needs different imagery.",
      "options": [
        {
          "value": "any",
          "label": "Any format"
        },
        {
          "value": "print",
          "label": "Archival Quality Print"
        },
        {
          "value": "canvas",
          "label": "Giclée Canvas"
        }
      ],
      "default": "any"
    }
  ],
  "presets": [
    {
      "name": "Option description"
    }
  ]
}
{% endschema %}
