{%- liquid
  assign heading = block.settings.heading | default: 'Included:'
  assign items = block.settings.item_1 | append: '||' | append: block.settings.item_2 | append: '||' | append: block.settings.item_3 | append: '||' | append: block.settings.item_4 | append: '||' | append: block.settings.item_5 | split: '||'
-%}

<div class="pdp-included custom-artwork-after" {{ block.shopify_attributes }}>
  <p class="pdp-included__heading">{{ heading | escape }}</p>
  <ul class="pdp-included__list">
    {%- for item in items -%}
      {%- if item != blank -%}
        <li class="pdp-included__item{% if forloop.last %} pdp-included__item--star{% endif %}">
          <span class="pdp-included__icon" aria-hidden="true">
            {%- if forloop.last -%}
              {{ 'pdp-included-star.svg' | inline_asset_content }}
            {%- else -%}
              {{ 'pdp-included-check.svg' | inline_asset_content }}
            {%- endif -%}
          </span>
          <span>{{ item | escape }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .pdp-included {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .pdp-included__heading {
    margin: 0 0 0.3125rem;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.25;
    color: #242027;
  }

  .pdp-included__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pdp-included__item {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.25;
    color: #242027;
  }

  .pdp-included__icon {
    display: flex;
    width: 0.8125rem;
    height: 0.8125rem;
    margin-top: 0.1875rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
  }

  .pdp-included__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.pdp_included",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Included:"
    },
    {
      "type": "text",
      "id": "item_1",
      "label": "Item 1",
      "default": "Gallery-Framed Canvas — save $80"
    },
    {
      "type": "text",
      "id": "item_2",
      "label": "Item 2",
      "default": "Digital version - $29"
    },
    {
      "type": "text",
      "id": "item_3",
      "label": "Item 3",
      "default": "Complimentary shipping - $15"
    },
    {
      "type": "text",
      "id": "item_4",
      "label": "Item 4",
      "default": "Lifetime warranty"
    },
    {
      "type": "text",
      "id": "item_5",
      "label": "Item 5",
      "default": "Letter of Authenticity"
    }
  ],
  "presets": [
    {
      "name": "t:names.pdp_included",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
