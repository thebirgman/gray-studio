{%- liquid
  assign label = block.settings.label | default: 'Start editing'
-%}

<script
  src="{{ 'pdp-start-editing.js' | asset_url }}"
  type="module"
></script>

<pdp-start-editing class="pdp-start-editing custom-artwork-before" {{ block.shopify_attributes }}>
  <button type="button" class="pdp-start-editing__button">
    {{ label | escape }}
  </button>
</pdp-start-editing>

{% stylesheet %}
  .pdp-start-editing {
    display: block;
    width: 100%;
  }

  .pdp-start-editing__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 2.875rem;
    padding: 0.75rem 1.5rem;
    border: 0.5px solid #321c41;
    border-radius: 0.25rem;
    background: transparent;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    color: #321c41;
    cursor: pointer;
  }

  .pdp-start-editing__button:focus-visible {
    outline: 2px solid #321c41;
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.pdp_start_editing",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "Start editing"
    }
  ],
  "presets": [
    {
      "name": "t:names.pdp_start_editing",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
