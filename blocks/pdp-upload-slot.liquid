{%- liquid
  assign heading = block.settings.heading | default: "2. Upload your dog's photo"
  assign tips_label = block.settings.tips_label | default: 'Tips for best results'
  assign empty_label = block.settings.empty_label | default: 'Upload photo'
  assign filled_label = block.settings.filled_label | default: 'Change photo'
  assign requirements = block.settings.requirements | default: 'JPG or PNG, under 15MB, at least 1000px on the shortest side.'
  assign empty_hint = block.settings.empty_hint | default: 'Your format, size, and frame options will appear below once your free preview is ready.'
  assign helper = block.settings.helper | default: 'Up to 3 free tries per photo. Not right? Switching photos usually does it.'
  assign preview_uploaded = block.settings.preview_uploaded_state
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif
  assign preview_image = product.featured_image
-%}

<div
  class="pdp-upload"
  {{ block.shopify_attributes }}
  {% if preview_uploaded %}
    data-preview-uploaded
  {% endif %}
>
  <div class="pdp-upload__header">
    <p class="pdp-upload__heading">{{ heading | escape }}</p>
    <details class="pdp-upload__tips">
      <summary class="pdp-upload__tips-summary">
        <span class="pdp-upload__tips-icon" aria-hidden="true">
          {{ 'pdp-tips-info.svg' | inline_asset_content }}
        </span>
        <span class="pdp-upload__tips-label">{{ tips_label | escape }}</span>
      </summary>
      <div class="pdp-upload__tips-panel">
        <p class="pdp-upload__tips-title pdp-upload__tips-title--do">Do</p>
        <ul class="pdp-upload__tips-list">
          <li>
            <span aria-hidden="true">{{ 'pdp-tips-check.svg' | inline_asset_content }}</span>
            Face and body both visible
          </li>
          <li>
            <span aria-hidden="true">{{ 'pdp-tips-check.svg' | inline_asset_content }}</span>
            Good, even lighting
          </li>
          <li>
            <span aria-hidden="true">{{ 'pdp-tips-check.svg' | inline_asset_content }}</span>
            Just your dog in frame
          </li>
        </ul>
        <p class="pdp-upload__tips-title pdp-upload__tips-title--avoid">Avoid</p>
        <ul class="pdp-upload__tips-list">
          <li>
            <span aria-hidden="true">{{ 'pdp-tips-close.svg' | inline_asset_content }}</span>
            Sunglasses, harnesses or costumes
          </li>
          <li>
            <span aria-hidden="true">{{ 'pdp-tips-close.svg' | inline_asset_content }}</span>
            Dark or blurry shots
          </li>
          <li>
            <span aria-hidden="true">{{ 'pdp-tips-close.svg' | inline_asset_content }}</span>
            Other pets or people
          </li>
        </ul>
      </div>
    </details>
  </div>

  <div
    id="custom-artwork-upload"
    class="pdp-upload__slot"
    data-custom-artwork-upload
  >
    <div
      class="pdp-upload__empty"
      data-custom-artwork-upload-empty
    >
      <div class="pdp-upload__dropzone">
        <span class="pdp-upload__icon" aria-hidden="true">
          {{ 'pdp-upload-icon.svg' | inline_asset_content }}
        </span>
        <p class="pdp-upload__label">{{ empty_label | escape }}</p>
        <div class="pdp-upload__requirements">
          <p>{{ requirements | escape }}</p>
          <p>{{ empty_hint | escape }}</p>
        </div>
      </div>
    </div>

    <div
      class="pdp-upload__filled"
      data-custom-artwork-upload-filled
    >
      <div class="pdp-upload__change">
        <div class="pdp-upload__change-row">
          {%- if preview_image != blank -%}
            {{
              preview_image
              | image_url: width: 80
              | image_tag:
                class: 'pdp-upload__thumb',
                widths: '50, 80',
                sizes: '25px',
                loading: 'lazy',
                alt: ''
            }}
          {%- endif -%}
          <span class="pdp-upload__icon" aria-hidden="true">
            {{ 'pdp-change-photo.svg' | inline_asset_content }}
          </span>
          <p class="pdp-upload__label pdp-upload__label--filled">{{ filled_label | escape }}</p>
        </div>
        <p class="pdp-upload__requirements pdp-upload__requirements--single">{{ requirements | escape }}</p>
      </div>
    </div>
  </div>

  <p class="pdp-upload__helper">{{ helper | escape }}</p>
</div>

{% stylesheet %}
  .pdp-upload {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
  }

  .pdp-upload__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
    width: 100%;
  }

  .pdp-upload__heading {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    text-transform: uppercase;
    color: #242027;
  }

  .pdp-upload__tips {
    width: 100%;
  }

  .pdp-upload__tips-summary {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    cursor: pointer;
    color: #3b61ba;
  }

  .pdp-upload__tips-summary::-webkit-details-marker,
  .pdp-upload__tips-summary::marker {
    display: none;
    content: '';
  }

  .pdp-upload__tips-icon {
    display: flex;
    width: 0.915rem;
    height: 0.915rem;
    flex-shrink: 0;
  }

  .pdp-upload__tips-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pdp-upload__tips-label {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.25;
    text-decoration: underline;
  }

  .pdp-upload__tips-panel {
    margin-top: 0.625rem;
    padding: 1.25rem;
    border-radius: 0.625rem;
    background: #faf8f0;
  }

  .pdp-upload__tips-title {
    margin: 0 0 0.25rem;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .pdp-upload__tips-title--do {
    color: #c0d933;
  }

  .pdp-upload__tips-title--avoid {
    margin-top: 0.75rem;
    color: #952327;
  }

  .pdp-upload__tips-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pdp-upload__tips-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.25;
    color: #242027;
  }

  .pdp-upload__tips-list svg {
    display: block;
    width: 0.8125rem;
    height: 0.8125rem;
    margin-top: 0.2rem;
    flex-shrink: 0;
  }

  .pdp-upload__slot {
    width: 100%;
  }

  .pdp-upload__dropzone,
  .pdp-upload__change {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1rem;
    border-radius: 0.75rem;
    text-align: center;
  }

  .pdp-upload__dropzone {
    min-height: 10.75rem;
    border: 1.5px dashed #d9d6db;
  }

  .pdp-upload__change {
    min-height: 4.875rem;
    border: 1px solid #d9d6db;
    border-radius: 0.625rem;
  }

  .pdp-upload__change-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
  }

  .pdp-upload__icon {
    display: flex;
    width: 1.3125rem;
    height: 1.3125rem;
    flex-shrink: 0;
    overflow: hidden;
  }

  .pdp-upload__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pdp-upload__label {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.375;
    color: #605c64;
  }

  .pdp-upload__label--filled {
    color: #242027;
  }

  .pdp-upload__thumb {
    display: block;
    width: 1.5625rem;
    height: 1.5625rem;
    object-fit: cover;
    border-radius: 0.1875rem;
    border-bottom: 3px solid #321c41;
  }

  .pdp-upload__requirements {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.5;
    color: #605c64;
    text-align: center;
  }

  .pdp-upload__requirements p {
    margin: 0;
  }

  .pdp-upload__helper {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.25;
    color: #605c64;
  }

  @media screen and (min-width: 750px) {
    .pdp-upload__header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    .pdp-upload__tips {
      width: auto;
      max-width: 16.875rem;
    }

    .pdp-upload__tips-summary {
      justify-content: flex-end;
    }

    .pdp-upload__dropzone {
      min-height: 9.0625rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.pdp_upload_slot",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "2. Upload your dog's photo"
    },
    {
      "type": "text",
      "id": "tips_label",
      "label": "Tips label",
      "default": "Tips for best results"
    },
    {
      "type": "text",
      "id": "empty_label",
      "label": "Empty label",
      "default": "Upload photo"
    },
    {
      "type": "text",
      "id": "filled_label",
      "label": "Filled label",
      "default": "Change photo"
    },
    {
      "type": "textarea",
      "id": "requirements",
      "label": "File requirements",
      "default": "JPG or PNG, under 15MB, at least 1000px on the shortest side."
    },
    {
      "type": "textarea",
      "id": "empty_hint",
      "label": "Empty hint",
      "default": "Your format, size, and frame options will appear below once your free preview is ready."
    },
    {
      "type": "textarea",
      "id": "helper",
      "label": "Helper text",
      "default": "Up to 3 free tries per photo. Not right? Switching photos usually does it."
    },
    {
      "type": "checkbox",
      "id": "preview_uploaded_state",
      "label": "Preview uploaded state",
      "default": false,
      "info": "Theme editor only. Shows the change-photo, prompt, and buy layout."
    }
  ],
  "presets": [
    {
      "name": "t:names.pdp_upload_slot",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
