{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign from_price = product.price_min | money
  assign max_price = product.price_max | money
  assign suffix = block.settings.suffix
  assign show_range_mobile = block.settings.show_range_mobile
-%}

{%- if product != blank -%}
  <p
    class="pdp-from-price"
    {{ block.shopify_attributes }}
  >
    <span class="pdp-from-price__desktop{% if show_range_mobile %} hidden--mobile{% endif %}">
      <span class="pdp-from-price__amount">From {{ from_price }}</span>
      {%- if suffix != blank -%}
        <span class="pdp-from-price__suffix">{{ suffix | escape }}</span>
      {%- endif -%}
    </span>
    {%- if show_range_mobile -%}
      <span class="pdp-from-price__range hidden--desktop">{{ from_price }} – {{ max_price }}</span>
    {%- endif -%}
  </p>
{%- endif -%}

{% stylesheet %}
  .pdp-from-price {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.5;
    color: #242027;
  }

  .pdp-from-price__desktop {
    display: flex;
    align-items: center;
    gap: 0.9375rem;
    flex-wrap: wrap;
  }

  .pdp-from-price__suffix {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1;
    color: #918d95;
    white-space: nowrap;
  }

  .pdp-from-price__range {
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.pdp_from_price",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "suffix",
      "label": "Suffix"
    },
    {
      "type": "checkbox",
      "id": "show_range_mobile",
      "label": "Show price range on mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:names.pdp_from_price",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
