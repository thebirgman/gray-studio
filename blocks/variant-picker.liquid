{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{% comment %}
  Nested Option description blocks are settings-only. Keep them in the tree with
  content_for so theme editor uploads stay attached to this picker.

  block.blocks is empty once this block is passed into a snippet, so resolve
  copy and frame images here and hand the snippet a flat row list:
  option value || description || badge || format scope || image url @@
{% endcomment %}
<div class="variant-picker__option-descriptions" hidden>
  {% content_for 'blocks' %}
</div>

{%- liquid
  assign option_description_rows = ''
  for desc_block in block.blocks
    if desc_block.type == '_option-description' or desc_block.type == 'option_description'
      assign row_value = desc_block.settings.option_value | strip | replace: '||', ' ' | replace: '@@', ' '
      assign row_description = desc_block.settings.description | strip | strip_newlines | replace: '||', ' ' | replace: '@@', ' '
      assign row_badge = desc_block.settings.badge | strip | replace: '||', ' ' | replace: '@@', ' '
      assign row_scope = desc_block.settings.format_scope | default: 'any' | strip
      assign row_image = ''
      if desc_block.settings.image != blank
        capture row_image
          echo desc_block.settings.image | image_url: width: 240
        endcapture
        assign row_image = row_image | strip
      endif
      assign option_description_rows = option_description_rows | append: row_value | append: '||' | append: row_description | append: '||' | append: row_badge | append: '||' | append: row_scope | append: '||' | append: row_image | append: '@@'
    endif
  endfor
-%}

{% unless product_resource == blank %}
  {% render 'variant-main-picker',
    product_resource: product_resource,
    section: section,
    product: product,
    block: block,
    option_description_rows: option_description_rows
  %}
{% endunless %}

{% schema %}
{
  "name": "t:names.product_variant_picker",
  "tag": null,
  "blocks": [
    {
      "type": "_option-description"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.type"
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "dropdowns",
          "label": "t:options.dropdowns"
        },
        {
          "value": "buttons",
          "label": "t:options.buttons"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:settings.swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_option_descriptions",
      "label": "Show option descriptions",
      "default": false,
      "info": "Renders Format and Size as cards. Frame is a cart property shown for physical formats (Archival Quality Print, Giclée Canvas).",
      "visible_if": "{{ block.settings.variant_style == 'buttons' }}"
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "label": "Size guide label",
      "default": "Size guide",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.show_option_descriptions }}"
    },
    {
      "type": "text",
      "id": "size_guide_heading",
      "label": "Size guide modal title",
      "default": "Size guide",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.show_option_descriptions }}"
    },
    {
      "type": "image_picker",
      "id": "size_guide_image",
      "label": "Size guide image",
      "info": "Opens in a modal when Size guide is clicked.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.show_option_descriptions }}"
    },
    {
      "type": "url",
      "id": "size_guide_link",
      "label": "Size guide link",
      "info": "Used only if no size guide image is uploaded.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.show_option_descriptions }}"
    },
    {
      "type": "text",
      "id": "frame_guide_label",
      "label": "Frame guide label",
      "default": "Frame guide",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.show_option_descriptions }}"
    },
    {
      "type": "text",
      "id": "frame_guide_heading",
      "label": "Frame guide modal title",
      "default": "Frame guide",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.show_option_descriptions }}"
    },
    {
      "type": "image_picker",
      "id": "frame_guide_image_print",
      "label": "Frame guide image (Archival Quality Print)",
      "info": "Shown when Archival Quality Print is selected.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.show_option_descriptions }}"
    },
    {
      "type": "image_picker",
      "id": "frame_guide_image_canvas",
      "label": "Frame guide image (Giclée Canvas)",
      "info": "Shown when Giclée Canvas is selected.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.show_option_descriptions }}"
    },
    {
      "type": "image_picker",
      "id": "frame_guide_image",
      "label": "Frame guide image (fallback)",
      "info": "Used for a format that does not have its own image above.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.show_option_descriptions }}"
    },
    {
      "type": "url",
      "id": "frame_guide_link",
      "label": "Frame guide link",
      "info": "Used only if no frame guide image is uploaded.",
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.show_option_descriptions }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "option_label_text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default",
      "alpha": true
    },
    {
      "type": "select",
      "id": "variant_style_class",
      "label": "t:settings.variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_variants_in_theme_settings"
    },
    {
      "type": "color",
      "id": "custom_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "select",
      "id": "selected_variant_style_class",
      "label": "t:settings.selected_variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.variant_style == 'buttons' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "checkbox",
      "id": "use_mobile_padding",
      "label": "Use mobile padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ block.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start-mobile",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end-mobile",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.use_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_variant_picker",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
