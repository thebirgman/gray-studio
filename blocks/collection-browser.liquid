{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign browse_collection = block.settings.collection
  if browse_collection == blank and product != blank
    for col in product.collections
      if col.handle != 'all' and col.handle != 'frontpage'
        assign browse_collection = col
        break
      endif
    endfor
    if browse_collection == blank
      assign browse_collection = product.collections.first
    endif
  endif

  assign scene_name = product.title
  if product.title contains ' - '
    assign title_parts = product.title | split: ' - '
    assign scene_name = title_parts.last | strip
  endif

  assign heading = block.settings.heading | default: 'Browse the collection'
-%}

{%- if browse_collection != blank and browse_collection.products_count > 1 -%}
  <details class="collection-browser" {{ block.shopify_attributes }}>
    <summary class="collection-browser__summary">
      <span class="collection-browser__copy">
        <span class="collection-browser__heading">{{ heading | escape }}</span>
        <span class="collection-browser__scene collection-browser__scene--desktop">{{ scene_name | escape }}</span>
        <span class="collection-browser__scene collection-browser__scene--mobile">
          Image selected - {{ scene_name | escape }}
        </span>
      </span>
      <span class="collection-browser__chevron" aria-hidden="true">
        {{ 'pdp-collection-chevron.svg' | inline_asset_content }}
      </span>
    </summary>

    <div class="collection-browser__panel">
      <ul class="collection-browser__grid" role="list">
        {%- for item in browse_collection.products limit: 16 -%}
          <li class="collection-browser__item">
            <a
              class="collection-browser__link{% if item.id == product.id %} collection-browser__link--current{% endif %}"
              href="{{ item.url }}"
              {% if item.id == product.id %}
                aria-current="page"
              {% endif %}
            >
              {%- if item.featured_image != blank -%}
                {{
                  item.featured_image
                  | image_url: width: 120
                  | image_tag:
                    class: 'collection-browser__image',
                    loading: 'lazy',
                    widths: '88, 120',
                    sizes: '44px',
                    alt: item.title
                }}
              {%- endif -%}
              <span class="visually-hidden">{{ item.title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </details>
{%- endif -%}

{% stylesheet %}
  .collection-browser {
    width: 100%;
  }

  .collection-browser__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    padding: 0;
    list-style: none;
    cursor: pointer;
  }

  .collection-browser__summary::-webkit-details-marker,
  .collection-browser__summary::marker {
    display: none;
    content: '';
  }

  .collection-browser__summary:focus-visible {
    outline: 2px solid #321c41;
    outline-offset: 2px;
  }

  .collection-browser__copy {
    display: flex;
    align-items: baseline;
    gap: 0.3125rem;
    min-width: 0;
  }

  .collection-browser__heading {
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.375;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #321c41;
    white-space: nowrap;
  }

  @media screen and (min-width: 750px) {
    .collection-browser__heading {
      font-size: 1rem;
      line-height: 1.375;
    }
  }

  .collection-browser__scene {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1.5;
    color: #605c64;
  }

  .collection-browser__scene--desktop {
    display: none;
  }

  .collection-browser__scene--mobile {
    display: inline;
  }

  @media screen and (min-width: 750px) {
    .collection-browser__scene--desktop {
      display: inline;
    }

    .collection-browser__scene--mobile {
      display: none;
    }
  }

  .collection-browser__chevron {
    display: flex;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .collection-browser__chevron svg {
    display: block;
    width: 0.8125rem;
    height: auto;
  }

  .collection-browser[open] .collection-browser__chevron {
    transform: rotate(180deg);
  }

  .collection-browser__panel {
    padding-block-start: 0.75rem;
  }

  .collection-browser__grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-browser__link {
    display: block;
    width: 2.75rem;
    height: 2.75rem;
    overflow: hidden;
    border: 1px solid transparent;
  }

  .collection-browser__link--current {
    border-color: #242027;
  }

  .collection-browser__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_browser",
  "tag": null,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection",
      "info": "t:info.pdp_collection_browser"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Browse the collection"
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_browser",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
