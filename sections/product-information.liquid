{% render 'ls-product-schema', product: closest.product %}

{% capture media_gallery %}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% if template.suffix == 'custom-artwork' %}
  <script
    src="{{ 'pdp-custom-artwork.js' | asset_url }}"
    type="module"
  ></script>
  <custom-artwork-pdp>
{% endif %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% liquid
    assign product = closest.product
    assign current_variant = product.selected_or_first_available_variant
    assign sticky_format = ''
    assign sticky_size = ''

    for option in product.options_with_values
      assign option_handle = option.name | handleize
      assign option_value = blank
      if option.position == 1
        assign option_value = current_variant.option1
      elsif option.position == 2
        assign option_value = current_variant.option2
      else
        assign option_value = current_variant.option3
      endif
      if option_handle == 'format' or option_handle contains 'format' or option_handle contains 'print'
        assign sticky_format = option_value
      elsif option_handle == 'size' or option_handle contains 'size'
        assign sticky_size_handle = option_value | handleize
        unless sticky_size_handle contains 'digital'
          assign sticky_size = option_value | split: '-' | first | strip
        endunless
      endif
    endfor

    if sticky_format != blank and sticky_size != blank
      assign sticky_variant_label = sticky_format | append: ', ' | append: sticky_size
    elsif sticky_format != blank
      assign sticky_variant_label = sticky_format
    elsif current_variant != blank
      assign sticky_variant_label = current_variant.title
    endif
  %}

  <sticky-add-to-cart
    class="sticky-add-to-cart"
    data-variant-available="{{ current_variant.available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar color-custom-popover"
      data-stuck="false"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      <div class="sticky-add-to-cart__inner">
        {% liquid
          assign image_to_show = current_variant.featured_image | default: product.featured_image
        %}
        <div class="sticky-add-to-cart__product">
          {% if image_to_show %}
            <div class="sticky-add-to-cart__image">
              {% assign image_alt = image_to_show.alt | default: product.title | escape %}
              {{
                image_to_show
                | image_url: width: 120
                | image_tag:
                  loading: 'lazy',
                  alt: image_alt,
                  class: 'sticky-add-to-cart__image-img',
                  data-testid: 'sticky-product-image',
                  srcset: null,
                  sizes: null,
                  ref: 'productImage'
              }}
            </div>
          {% endif %}

          {% liquid
            if image_to_show == blank
              assign has_image = false
            else
              assign has_image = true
            endif
          %}
          <div
            class="sticky-add-to-cart__info"
            data-has-image="{{ has_image }}"
            data-singleton="{{ product.has_only_default_variant }}"
          >
            <p
              class="sticky-add-to-cart__title"
              data-testid="sticky-product-title"
            >
              {{ product.title | escape }}
            </p>
            <div
              class="sticky-add-to-cart__variant"
              data-testid="sticky-variant-title"
              {% if product.has_only_default_variant %}
                style="display: none;"
              {% endif %}
            >
              {%- unless product.has_only_default_variant -%}
                {{ sticky_variant_label | escape }}
              {%- endunless -%}
            </div>
          </div>

          <div
            class="sticky-add-to-cart__price"
            data-testid="sticky-price-display"
          >
            {{ current_variant.price | money }}
          </div>
        </div>

        <div class="sticky-add-to-cart__actions">
          <button
            type="button"
            class="sticky-add-to-cart__button add-to-cart-button button"
            ref="addToCartButton"
            on:click="/handleAddToCartClick"
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            <span class="add-to-cart-text">
              <span class="add-to-cart-text__content">
                <span>
                  {%- if current_variant.available -%}
                    {{- 'products.product.add_to_cart' | t -}}
                  {%- elsif current_variant == blank -%}
                    {{- 'products.product.unavailable' | t -}}
                  {%- else -%}
                    {{- 'products.product.sold_out' | t -}}
                  {%- endif -%}
                </span>
              </span>
            </span>
            <span class="add-to-cart__added">
              <span class="svg-wrapper add-to-cart__added-icon">
                {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
              </span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </sticky-add-to-cart>
{% endif %}

{% render 'product-information-content',
  product: closest.product,
  section_id: section.id,
  settings: section.settings,
  media_gallery: media_gallery,
  product_details: product_details,
  additional_blocks: additional_blocks
%}

{% render 'pdp-main-styles' %}
{% if template.suffix == 'custom-artwork' %}
  {% render 'pdp-custom-artwork-styles' %}
  </custom-artwork-pdp>
{% endif %}

{% stylesheet %}
  .sticky-add-to-cart__bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    max-width: none;
    opacity: 0;
    transform: translateY(100%);
    z-index: calc(var(--layer-sticky) - 1);
    display: block;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    background: #fffefd;
    border-top: 1px solid #d9d6db;
  }

  .sticky-add-to-cart__bar::before {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticky-add-to-cart__bar {
      transition-property: transform, opacity, display;
      transition-duration: 0.3s;
      transition-timing-function: var(--ease-out-quad);
      transition-behavior: allow-discrete;
    }
  }

  .sticky-add-to-cart__bar[data-stuck='true'] {
    transform: translateY(0);
    opacity: 1;
  }

  sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__bar {
    opacity: 0;
    transform: translateY(100%);
    display: none;
  }

  .sticky-add-to-cart__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    max-width: var(--page-width, 90rem);
    margin: 0 auto;
    padding: 1rem 1.25rem;
  }

  .sticky-add-to-cart__product {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  .sticky-add-to-cart__image {
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--color-background-secondary);
  }

  .sticky-add-to-cart__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sticky-add-to-cart__info {
    min-width: 0;
    flex: 1 1 auto;
  }

  .sticky-add-to-cart__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.2;
    color: #242027;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sticky-add-to-cart__variant {
    margin-top: 0.125rem;
    color: #605c64;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sticky-add-to-cart__price {
    flex-shrink: 0;
    font-family: var(--font-body--family);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.2;
    color: #321c41;
    white-space: nowrap;
  }

  .sticky-add-to-cart__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
  }

  .sticky-add-to-cart__button {
    height: 2.875rem;
    min-height: 2.875rem;
    min-width: 10.5rem;
    padding: 0 1.25rem;
    border-radius: 0.25rem;
    background: #321c41;
    color: #fefefd;
    border: 0;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 500;
    position: relative;
  }

  .sticky-add-to-cart__button .add-to-cart-text__content {
    display: inline;
  }

  @media screen and (min-width: 750px) {
    .sticky-add-to-cart__inner {
      padding-inline: clamp(1.25rem, 8vw, 7.5rem);
    }
  }

  @media screen and (max-width: 749px) {
    .sticky-add-to-cart__inner {
      flex-wrap: wrap;
      padding: 0.625rem 0.625rem calc(0.625rem + env(safe-area-inset-bottom));
      gap: 0.625rem;
    }

    .sticky-add-to-cart__product {
      flex: 1 1 100%;
      width: 100%;
      min-width: 0;
    }

    .sticky-add-to-cart__title {
      font-size: 1rem;
      line-height: 1.375;
    }

    .sticky-add-to-cart__price {
      font-size: 1rem;
      line-height: 1.375;
      align-self: flex-start;
      padding-top: 0.125rem;
    }

    .sticky-add-to-cart__image {
      width: 3.5rem;
      height: 3.5rem;
    }

    .sticky-add-to-cart__actions {
      flex: 1 1 100%;
      width: 100%;
    }

    .sticky-add-to-cart__button {
      flex: 1 1 100%;
      min-width: 0;
      width: 100%;
    }

    .sticky-add-to-cart__variant {
      font-size: 0.75rem;
      line-height: 1.125;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "use_mobile_gap",
      "label": "Use mobile gap",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.use_mobile_gap }}"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
