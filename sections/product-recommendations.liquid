<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign background_color = section.settings.background_color | default: '#FFFDF8'
  assign brand_color = section.settings.brand_color | default: '#321C41'
  assign badge_color = section.settings.badge_color | default: '#8855AA'
  assign star_color = section.settings.star_color | default: '#F5CD72'
  assign text_color = section.settings.text_color | default: '#242027'
  assign muted_color = section.settings.muted_color | default: '#605C64'
  assign max_products = section.settings.max_products | default: 4

  assign source_product = section.settings.product
  if source_product == blank
    assign source_product = product
  endif

  if button_link == blank and section.settings.collection != blank
    assign button_link = section.settings.collection.url
  endif

  assign rec_products = null
  assign show_placeholders = false
  assign show_skeleton = false

  if source_product == blank
    assign show_placeholders = true
  elsif recommendations.performed
    if recommendations.products_count > 0
      assign rec_products = recommendations.products
    elsif section.settings.recommendation_type == 'related'
      assign rec_products = collections.all.products | reject: 'id', source_product.id
    endif
  else
    assign show_skeleton = true
  endif

  assign placeholder_titles = 'Digital Download,Archival Quality Print,Giclée Canvas' | split: ','
  assign placeholder_prices = '29,79,149,194' | split: ','

  if rec_products != blank
    assign rp_columns = rec_products.size
    if rp_columns > max_products
      assign rp_columns = max_products
    endif
  elsif show_placeholders
    assign rp_columns = placeholder_titles.size
  else
    assign rp_columns = max_products
  endif
  if rp_columns > 4
    assign rp_columns = 4
  endif
  if rp_columns < 1
    assign rp_columns = 4
  endif

  if rec_products != blank and rec_products.size > 0
    assign has_recommendations = 'true'
  elsif show_placeholders
    assign has_recommendations = 'true'
  elsif show_skeleton
    assign has_recommendations = 'true'
  else
    assign has_recommendations = 'false'
  endif
-%}

{% render 'contrast-override',
  background_color: background_color,
  text_color: text_color,
  section_id: section.id,
  skip_contrast: true
%}

<product-recommendations
  id="product-recommendations-{{ section.id }}"
  class="product-recommendations related-prints-root"
  data-url="{{ routes.product_recommendations_url }}?limit={{ max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ source_product.id }}"
  data-intent="{{ section.settings.recommendation_type }}"
  data-testid="product-recommendations-section"
  data-recommendations-performed="{{ recommendations.performed }}"
  data-hydration-key="product-recommendations-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div
    class="section-background color-custom-{{ section.id }}"
    style="background-color: {{ background_color }};"
  ></div>

  <div
    class="
      section
      section--full-width
      related-prints
      color-custom-{{ section.id }}
      spacing-style
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      --rp-bg: {{ background_color }};
      --rp-text: {{ text_color }};
      --rp-muted: {{ muted_color }};
      --rp-brand: {{ brand_color }};
      --rp-badge: {{ badge_color }};
      --rp-star: {{ star_color }};
      --rp-on-brand: #FEFEFD;
      --rp-columns: {{ rp_columns }};
      --rp-gap: 20px;
      background-color: {{ background_color }};
    "
  >
    <div
      class="related-prints__layout"
      data-has-recommendations="{{ has_recommendations }}"
    >
      <div class="related-prints__header">
        <div class="related-prints__heading-group">
          {%- if eyebrow != blank -%}
            <p class="related-prints__eyebrow">{{ eyebrow }}</p>
          {%- endif -%}
          {%- if heading != blank -%}
            <h2 class="related-prints__heading">{{ heading }}</h2>
          {%- endif -%}
        </div>

        {%- if button_label != blank -%}
          <a
            class="related-prints__cta"
            {% if button_link != blank %}
              href="{{ button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            <span>{{ button_label }}</span>
            <span class="related-prints__cta-icon" aria-hidden="true">
              {{ 'icon-long-arrow-right.svg' | inline_asset_content }}
            </span>
          </a>
        {%- endif -%}
      </div>

      <div class="related-prints__grid">
        {%- if show_skeleton -%}
          {%- for i in (1..rp_columns) -%}
            <div
              class="related-prints__card related-prints__card--skeleton"
              aria-label="{{ 'accessibility.loading_product_recommendations' | t }}"
            >
              <div class="related-prints__media"></div>
              <div class="related-prints__meta">
                <span class="related-prints__skeleton-line"></span>
                <span class="related-prints__skeleton-line related-prints__skeleton-line--short"></span>
                <span class="related-prints__skeleton-line related-prints__skeleton-line--price"></span>
              </div>
            </div>
          {%- endfor -%}
        {%- elsif show_placeholders -%}
          {%- for title in placeholder_titles -%}
            {%- liquid
              assign display_price = placeholder_prices[forloop.index0] | times: 100 | money_without_trailing_zeros
              assign show_badge = false
              assign badge_position = section.settings.badge_position | plus: 0
              if section.settings.show_badge and forloop.index == badge_position
                assign show_badge = true
              endif
            -%}
            {% render 'related-prints-card',
              title: title,
              price: display_price,
              show_badge: show_badge,
              badge_label: section.settings.badge_label,
              placeholder: true
            %}
          {%- endfor -%}
        {%- elsif rec_products != blank -%}
          {%- for rec_product in rec_products limit: max_products -%}
            {%- liquid
              assign show_badge = false
              assign badge_position = section.settings.badge_position | plus: 0
              if section.settings.show_badge and forloop.index == badge_position
                assign show_badge = true
              endif
            -%}
            {% render 'related-prints-card',
              product: rec_product,
              show_badge: show_badge,
              badge_label: section.settings.badge_label
            %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</product-recommendations>

{% stylesheet %}
  .related-prints-root.product-recommendations > * {
    border: none;
  }

  .related-prints {
    color: var(--rp-text);
  }

  .related-prints__layout {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;
    width: 100%;
  }

  .related-prints__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    width: 100%;
  }

  .related-prints__heading-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3125rem;
    color: var(--rp-text);
  }

  .related-prints__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.03125rem;
    text-transform: uppercase;
  }

  .related-prints__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 2.25rem;
    letter-spacing: 0;
    color: inherit;
  }

  .related-prints__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
    border-bottom: 0.5px solid var(--rp-brand);
    color: var(--rp-brand);
    text-decoration: none;
    font-family: var(--font-button--family, var(--font-body--family));
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
    flex-shrink: 0;
  }

  .related-prints__cta[aria-disabled='true'] {
    pointer-events: none;
  }

  .related-prints__cta:hover {
    opacity: 0.75;
  }

  .related-prints__cta:focus-visible {
    outline: 2px solid var(--rp-brand);
    outline-offset: 2px;
  }

  .related-prints__cta-icon {
    display: inline-flex;
    width: 1.125rem;
    height: 1.125rem;
    overflow: clip;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .related-prints__cta-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .related-prints__grid {
    display: flex;
    gap: var(--rp-gap, 20px);
    width: calc(
      100% + var(--padding-inline-start-mobile, var(--padding-inline-start, 0px)) +
        var(--padding-inline-end-mobile, var(--padding-inline-end, 0px))
    );
    margin-inline: calc(var(--padding-inline-start-mobile, var(--padding-inline-start, 0px)) * -1)
      calc(var(--padding-inline-end-mobile, var(--padding-inline-end, 0px)) * -1);
    padding-inline: var(--padding-inline-start-mobile, var(--padding-inline-start, 1.5625rem))
      var(--padding-inline-end-mobile, var(--padding-inline-end, 1.5625rem));
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
  }

  .related-prints__grid::-webkit-scrollbar {
    display: none;
  }

  .related-prints__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 0 0 75%;
    width: 75%;
    min-width: 0;
    gap: 0.9375rem;
    color: inherit;
    text-decoration: none;
    scroll-snap-align: start;
  }

  .related-prints__card[aria-disabled='true'] {
    pointer-events: none;
  }

  .related-prints__media {
    position: relative;
    width: 100%;
    aspect-ratio: 282 / 288;
    overflow: hidden;
  }

  .related-prints__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-prints__image--placeholder {
    width: 100%;
    height: 100%;
  }

  .related-prints__badge {
    position: absolute;
    top: 0.625rem;
    left: 0.625rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-height: 1.1875rem;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    background-color: var(--rp-badge);
    color: var(--rp-on-brand);
  }

  .related-prints__badge-icon {
    display: inline-flex;
    width: 0.75rem;
    height: 0.75rem;
    overflow: clip;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .related-prints__badge-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .related-prints__badge-label {
    font-family: var(--font-body--family);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.03125rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .related-prints__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3125rem;
    width: 100%;
  }

  .related-prints__title {
    margin: 0;
    width: 100%;
    font-family: var(--font-accent--family, var(--font-body--family));
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.06875rem;
    text-transform: uppercase;
    color: var(--rp-text);
  }

  .related-prints__rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .related-prints__stars {
    display: flex;
    align-items: center;
    gap: 0.1875rem;
  }

  .related-prints__star {
    display: inline-flex;
    width: 0.625rem;
    height: 0.625rem;
    overflow: clip;
    flex-shrink: 0;
    color: var(--rp-star);
  }

  .related-prints__star svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .related-prints__rating-count {
    font-family: var(--font-body--family);
    font-size: 0.4375rem;
    font-weight: 400;
    line-height: 0.9375rem;
    text-transform: uppercase;
    color: var(--rp-muted);
  }

  .related-prints__price {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6875rem;
    color: var(--rp-text);
  }

  .related-prints__card--skeleton {
    pointer-events: none;
  }

  .related-prints__card--skeleton .related-prints__media,
  .related-prints__skeleton-line {
    background-color: #efece8;
  }

  .related-prints__skeleton-line {
    display: block;
    width: 70%;
    height: 0.6875rem;
    border-radius: 0.125rem;
  }

  .related-prints__skeleton-line--short {
    width: 40%;
    height: 0.625rem;
  }

  .related-prints__skeleton-line--price {
    width: 30%;
    height: 1.125rem;
  }

  @media screen and (min-width: 750px) {
    .related-prints__header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .related-prints__heading {
      font-size: 2.5rem;
      line-height: 1.08;
      letter-spacing: -0.0125rem;
    }

    .related-prints__grid {
      display: grid;
      grid-template-columns: repeat(var(--rp-columns, 4), minmax(0, 1fr));
      gap: var(--rp-gap, 20px);
      width: 100%;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .related-prints__card {
      flex: none;
      width: 100%;
      max-width: none;
      scroll-snap-align: none;
    }
  }

  @media screen and (max-width: 768px) {
    .related-prints__grid {
      scroll-padding-left: 25px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_recommendations",
  "tag": "section",
  "class": "related-prints-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "related",
          "label": "t:options.related"
        },
        {
          "value": "complementary",
          "label": "t:options.complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "t:content.complementary_products"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MORE TO DISCOVER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Prints that actually last"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore all styles"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection",
      "info": "Used for the button link when no URL is set."
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "default": "Most loved",
      "visible_if": "{{ section.settings.show_badge }}"
    },
    {
      "type": "range",
      "id": "badge_position",
      "label": "Badge product",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 3,
      "info": "Which recommended product shows the badge (1 = first).",
      "visible_if": "{{ section.settings.show_badge }}"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#242027"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#605C64"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Brand",
      "default": "#321C41"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge",
      "default": "#8855AA"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Stars",
      "default": "#F5CD72"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "checkbox",
      "id": "use_mobile_padding",
      "label": "Use mobile padding",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start-mobile",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 25,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end-mobile",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 25,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_recommendations",
      "category": "t:categories.products",
      "settings": {
        "product": "{{ closest.product }}",
        "recommendation_type": "related",
        "max_products": 4,
        "eyebrow": "MORE TO DISCOVER",
        "heading": "Prints that actually last",
        "button_label": "Explore all styles",
        "show_badge": true,
        "badge_label": "Most loved",
        "badge_position": 3,
        "background_color": "#FFFDF8",
        "text_color": "#242027",
        "muted_color": "#605C64",
        "brand_color": "#321C41",
        "badge_color": "#8855AA",
        "star_color": "#F5CD72",
        "padding-block-start": 100,
        "padding-block-end": 120,
        "padding-inline-start": 120,
        "padding-inline-end": 120,
        "use_mobile_padding": true,
        "padding-block-start-mobile": 60,
        "padding-block-end-mobile": 60,
        "padding-inline-start-mobile": 25,
        "padding-inline-end-mobile": 25
      }
    }
  ]
}
{% endschema %}
