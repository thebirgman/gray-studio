{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign button_label = section.settings.button_label
  assign placeholder = section.settings.placeholder
  assign panel_color = section.settings.panel_color | default: '#FAF8F0'
  assign text_color = section.settings.text_color | default: '#242027'
  assign brand_color = section.settings.brand_color | default: '#321C41'
  assign input_border = section.settings.input_border | default: '#D9D6DB'
  assign placeholder_color = section.settings.placeholder_color | default: '#918D95'
  assign background_image = section.settings.background_image
  assign inset_image = section.settings.inset_image
  assign background_asset = section.settings.background_image_asset | default: 'join-the-pack-bg.jpg'
  assign inset_asset = section.settings.inset_image_asset | default: 'join-the-pack-inset.jpg'
  assign inset_alt = section.settings.inset_image_alt | default: heading
-%}

{% render 'contrast-override',
  background_color: panel_color,
  text_color: text_color,
  section_id: section.id,
  skip_contrast: true
%}

<div
  class="join-the-pack color-custom-{{ section.id }}"
  id="JoinThePack-{{ section.id }}"
  style="
    --jtp-panel: {{ panel_color }};
    --jtp-text: {{ text_color }};
    --jtp-brand: {{ brand_color }};
    --jtp-input-border: {{ input_border }};
    --jtp-placeholder: {{ placeholder_color }};
  "
>
  <div class="join-the-pack__backdrop" aria-hidden="true">
    {%- if background_image != blank -%}
      {{
        background_image
        | image_url: width: 2400
        | image_tag:
          class: 'join-the-pack__backdrop-img',
          widths: '750, 1100, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'lazy',
          alt: ''
      }}
    {%- else -%}
      <img
        class="join-the-pack__backdrop-img"
        src="{{ background_asset | asset_url }}"
        alt=""
        width="2400"
        height="2400"
        loading="lazy"
      >
    {%- endif -%}
  </div>

  <div class="join-the-pack__inner">
    <div class="join-the-pack__panel">
      <div class="join-the-pack__inset">
        {%- if inset_image != blank -%}
          {{
            inset_image
            | image_url: width: 700
            | image_tag:
              class: 'join-the-pack__inset-img',
              widths: '260, 360, 540, 700',
              sizes: '(min-width: 750px) 180px, 130px',
              loading: 'lazy',
              alt: inset_alt
          }}
        {%- else -%}
          <img
            class="join-the-pack__inset-img"
            src="{{ inset_asset | asset_url }}"
            alt="{{ inset_alt | escape }}"
            width="700"
            height="840"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      <div class="join-the-pack__content">
        {%- form 'customer', class: 'join-the-pack__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter, join-the-pack">

          <div class="join-the-pack__fields">
            <div class="join-the-pack__copy">
              {%- if heading != blank -%}
                <h2 class="join-the-pack__heading">{{ heading }}</h2>
              {%- endif -%}
              {%- if description != blank -%}
                <p class="join-the-pack__description">{{ description }}</p>
              {%- endif -%}
            </div>

            <label class="visually-hidden" for="JoinThePack-Email-{{ section.id }}">
              {{ 'blocks.email_signup.label' | t }}
            </label>

            <input
              id="JoinThePack-Email-{{ section.id }}"
              class="join-the-pack__input"
              type="email"
              name="contact[email]"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{% if placeholder != blank %}{{ placeholder | escape }}{% else %}{{ 'blocks.email_signup.placeholder' | t }}{% endif %}"
              required
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="JoinThePack-Error-{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="JoinThePack-Success-{{ section.id }}"
              {% endif %}
            >
          </div>

          <button type="submit" class="join-the-pack__submit">
            <span>{{ button_label }}</span>
            <span class="join-the-pack__submit-icon" aria-hidden="true">
              {{ 'icon-long-arrow-right.svg' | inline_asset_content }}
            </span>
          </button>

          {%- if form.errors -%}
            <div
              id="JoinThePack-Error-{{ section.id }}"
              class="join-the-pack__message join-the-pack__message--error"
              tabindex="-1"
            >
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <div
              id="JoinThePack-Success-{{ section.id }}"
              class="join-the-pack__message join-the-pack__message--success"
              tabindex="-1"
            >
              {{ 'blocks.email_signup.success' | t }}
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .join-the-pack {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    padding: 3.75rem 1.5625rem;
    color: var(--jtp-text, #242027);
  }

  .join-the-pack__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .join-the-pack__backdrop-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .join-the-pack__inner {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    width: 100%;
    max-width: 75rem;
    margin-inline: auto;
  }

  .join-the-pack__panel {
    position: relative;
    width: 100%;
    background-color: var(--jtp-panel, #faf8f0);
    padding: 1rem 1rem 1.75rem;
  }

  .join-the-pack__inset {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 8.125rem;
    height: 9.5rem;
    overflow: hidden;
  }

  .join-the-pack__inset-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .join-the-pack__content {
    width: 100%;
    padding-top: 11.25rem;
  }

  .join-the-pack__form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5625rem;
    width: 100%;
  }

  .join-the-pack__fields {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
  }

  .join-the-pack__copy {
    display: flex;
    flex-direction: column;
    gap: 0.5625rem;
    width: 100%;
  }

  .join-the-pack__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 2.25rem;
    letter-spacing: 0;
    color: inherit;
  }

  .join-the-pack__description {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.375rem;
  }

  .join-the-pack__input {
    width: 100%;
    height: 3rem;
    padding: 0 1rem;
    border: 1px solid var(--jtp-input-border, #d9d6db);
    border-radius: 0;
    background: #fff;
    color: var(--jtp-text, #242027);
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.375rem;
  }

  .join-the-pack__input::placeholder {
    color: var(--jtp-placeholder, #918d95);
  }

  .join-the-pack__input:focus-visible {
    outline: 2px solid var(--jtp-brand, #321c41);
    outline-offset: 2px;
  }

  .join-the-pack__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
    border: 0;
    border-bottom: 0.5px solid var(--jtp-brand, #321c41);
    border-radius: 0;
    background: transparent;
    color: var(--jtp-brand, #321c41);
    font-family: var(--font-accent--family, var(--font-body--family));
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    cursor: pointer;
  }

  .join-the-pack__submit:hover {
    opacity: 0.75;
  }

  .join-the-pack__submit:focus-visible {
    outline: 2px solid var(--jtp-brand, #321c41);
    outline-offset: 2px;
  }

  .join-the-pack__submit-icon {
    display: inline-flex;
    width: 1.125rem;
    height: 1.125rem;
    overflow: clip;
    align-items: center;
    justify-content: center;
  }

  .join-the-pack__submit-icon svg {
    width: 100%;
    height: 100%;
  }

  .join-the-pack__message {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.3;
  }

  .join-the-pack__message--error {
    color: #9b1c1c;
  }

  @media screen and (min-width: 750px) {
    .join-the-pack {
      padding: 4.875rem 7.5rem 5.4375rem;
    }

    .join-the-pack__panel {
      display: flex;
      align-items: flex-end;
      min-height: 23rem;
      padding: 1.875rem 1.875rem 1.75rem;
    }

    .join-the-pack__inset {
      top: 1.875rem;
      right: 1.875rem;
      width: 11.25rem;
      height: 13.125rem;
    }

    .join-the-pack__content {
      max-width: 33.3125rem;
      padding-top: 6.5625rem;
    }

    .join-the-pack__heading {
      font-size: 2.5rem;
      line-height: 1.08;
      letter-spacing: -0.0125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Join the Pack",
  "tag": "section",
  "class": "join-the-pack-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Pack"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Collect a daisy stamp with every commission. The sixth portrait is on us, plus early access to new scenes."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "inset_image",
      "label": "Inset image"
    },
    {
      "type": "text",
      "id": "background_image_asset",
      "label": "Background image asset filename",
      "default": "join-the-pack-bg.jpg",
      "info": "Used when no background image is selected"
    },
    {
      "type": "text",
      "id": "inset_image_asset",
      "label": "Inset image asset filename",
      "default": "join-the-pack-inset.jpg",
      "info": "Used when no inset image is selected"
    },
    {
      "type": "text",
      "id": "inset_image_alt",
      "label": "Inset image alt text",
      "default": "Pup sitting on a fountain with a croissant and coffee"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Panel background",
      "default": "#FAF8F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#242027"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Button color",
      "default": "#321C41"
    },
    {
      "type": "color",
      "id": "input_border",
      "label": "Input border",
      "default": "#D9D6DB"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder color",
      "default": "#918D95"
    }
  ],
  "presets": [
    {
      "name": "Join the Pack",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
