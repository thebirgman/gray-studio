{%- liquid
  assign heading = section.settings.heading
  assign marquee_text = section.settings.marquee_text | default: heading
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign background_color = section.settings.background_color | default: '#FBEECA'
  assign heading_color = section.settings.heading_color | default: '#733014'
  assign marquee_color = section.settings.marquee_color | default: '#FEF9EC'

  unless heading_tag == 'h1' or heading_tag == 'h2'
    assign heading_tag = 'h1'
  endunless
-%}

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Alex+Brush&display=swap"
  media="print"
  onload="this.media='all'"
>
<noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alex+Brush&display=swap">
</noscript>

{% render 'contrast-override',
  background_color: background_color,
  text_color: heading_color,
  section_id: section.id,
  skip_contrast: true
%}

<div
  class="page-hero color-custom-{{ section.id }}"
  id="PageHero-{{ section.id }}"
  style="
    --ph-bg: {{ background_color }};
    --ph-heading: {{ heading_color }};
    --ph-marquee: {{ marquee_color }};
  "
>
  {%- if marquee_text != blank -%}
    <div class="page-hero__marquee" aria-hidden="true">
      <div class="page-hero__marquee-track">
        <p class="page-hero__marquee-text">{{ marquee_text }}</p>
        <p class="page-hero__marquee-text">{{ marquee_text }}</p>
        <p class="page-hero__marquee-text">{{ marquee_text }}</p>
        <p class="page-hero__marquee-text">{{ marquee_text }}</p>
      </div>
    </div>
  {%- endif -%}

  {%- if heading != blank -%}
    <{{ heading_tag }} class="page-hero__heading">{{ heading }}</{{ heading_tag }}>
  {%- endif -%}
</div>

{% stylesheet %}
  /*
    Sit cream under the nav (not the announcement bar) whenever this section
    is first on the page. Header stays in flow with default dark logo/text.
  */
  body:has(.content-for-layout > .shopify-section.page-hero-section:first-child)
    .content-for-layout
    > .shopify-section.page-hero-section:first-child {
    margin-top: calc(var(--header-height) * -1);
  }

  body:has(.content-for-layout > .shopify-section.page-hero-section:first-child) #header-group > .header-section {
    position: relative;
    z-index: var(--layer-menu-drawer);
  }

  body:has(.content-for-layout > .shopify-section.page-hero-section:first-child)
    .header:not([data-sticky-state='active']) {
    --closed-underlay-height: 0px;
  }

  .page-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 20.1875rem;
    padding: 1.5625rem;
    overflow: clip;
    background-color: var(--ph-bg, #fbeeca);
  }

  .page-hero__marquee {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 0;
    height: 9.6875rem;
    overflow: hidden;
    pointer-events: none;
  }

  .page-hero__marquee-track {
    display: flex;
    width: max-content;
    height: 100%;
    align-items: flex-end;
    gap: 4rem;
  }

  .page-hero__marquee-text {
    margin: 0;
    flex-shrink: 0;
    font-family: 'Alex Brush', cursive;
    font-size: 10.5rem;
    font-weight: 400;
    line-height: 0.67;
    color: var(--ph-marquee, #fef9ec);
    white-space: nowrap;
  }

  .page-hero__heading {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 21.5rem;
    font-family: var(--font-heading--family);
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 2.75rem;
    letter-spacing: -0.0036px;
    text-align: center;
    color: var(--ph-heading, #733014);
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-hero__marquee-track {
      animation: page-hero-marquee 60s linear infinite;
    }
  }

  @keyframes page-hero-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (min-width: 750px) {
    .page-hero {
      min-height: 27.375rem;
      padding: 0 7.5rem;
    }

    .page-hero__marquee {
      height: 14.3125rem;
    }

    .page-hero__marquee-text {
      font-size: 21.5625rem;
      line-height: 1;
    }

    .page-hero__heading {
      max-width: 44.875rem;
      font-size: 3rem;
      line-height: 4.1875rem;
      letter-spacing: -0.0048px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page hero",
  "tag": "section",
  "class": "page-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Script watermark text",
      "info": "Large scrolling script behind the heading. Leave blank to use the heading."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FBEECA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#733014"
    },
    {
      "type": "color",
      "id": "marquee_color",
      "label": "Watermark",
      "default": "#FEF9EC"
    }
  ],
  "presets": [
    {
      "name": "Page hero",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
