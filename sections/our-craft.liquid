{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign stat_number = section.settings.stat_number
  assign stat_label = section.settings.stat_label
  assign background_color = section.settings.background_color | default: '#FFFDF8'
  assign text_color = section.settings.text_color | default: '#242027'
  assign brand_color = section.settings.brand_color | default: '#321C41'
  assign badge_color = section.settings.badge_color | default: '#C8AFDE'
  assign primary_image = section.settings.primary_image
  assign secondary_image = section.settings.secondary_image
  assign primary_asset = section.settings.primary_image_asset | default: 'our-craft-primary.jpg'
  assign secondary_asset = section.settings.secondary_image_asset | default: 'our-craft-secondary.jpg'
  assign primary_alt = section.settings.primary_image_alt | default: heading
  assign secondary_alt = section.settings.secondary_image_alt | default: heading
-%}

{% render 'contrast-override',
  background_color: background_color,
  text_color: text_color,
  section_id: section.id,
  skip_contrast: true
%}

<div
  class="section-background color-custom-{{ section.id }}"
  style="background-color: {{ background_color }};"
></div>

<div
  class="
    section
    section--full-width
    our-craft
    color-custom-{{ section.id }}
    spacing-style
  "
  id="OurCraft-{{ section.id }}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --oc-bg: {{ background_color }};
    --oc-text: {{ text_color }};
    --oc-brand: {{ brand_color }};
    --oc-badge: {{ badge_color }};
    background-color: {{ background_color }};
  "
>
  <div class="our-craft__layout">
    <div class="our-craft__media">
      <div class="our-craft__primary">
        {%- if primary_image != blank -%}
          {{
            primary_image
            | image_url: width: 1600
            | image_tag:
              class: 'our-craft__primary-img',
              widths: '400, 700, 1000, 1400, 1600',
              sizes: '(min-width: 750px) 40vw, 90vw',
              loading: 'lazy',
              alt: primary_alt
          }}
        {%- else -%}
          <img
            class="our-craft__primary-img"
            src="{{ primary_asset | asset_url }}"
            alt="{{ primary_alt | escape }}"
            width="1600"
            height="1600"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      <div class="our-craft__secondary">
        <div class="our-craft__secondary-image">
          {%- if secondary_image != blank -%}
            {{
              secondary_image
              | image_url: width: 800
              | image_tag:
                class: 'our-craft__secondary-img',
                widths: '200, 400, 600, 800',
                sizes: '(min-width: 750px) 216px, 170px',
                loading: 'lazy',
                alt: secondary_alt
            }}
          {%- else -%}
            <img
              class="our-craft__secondary-img"
              src="{{ secondary_asset | asset_url }}"
              alt="{{ secondary_alt | escape }}"
              width="800"
              height="800"
              loading="lazy"
            >
          {%- endif -%}
        </div>

        {%- if stat_number != blank or stat_label != blank -%}
          <div class="our-craft__stat">
            {%- if stat_number != blank -%}
              <p class="our-craft__stat-number">{{ stat_number }}</p>
            {%- endif -%}
            {%- if stat_label != blank -%}
              <p class="our-craft__stat-label">{{ stat_label }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="our-craft__content">
      <div class="our-craft__copy">
        <div class="our-craft__title">
          {%- if eyebrow != blank -%}
            <p class="our-craft__eyebrow">{{ eyebrow }}</p>
          {%- endif -%}
          {%- if heading != blank -%}
            <h2 class="our-craft__heading">{{ heading }}</h2>
          {%- endif -%}
        </div>
        {%- if description != blank -%}
          <div class="our-craft__description rte">{{ description }}</div>
        {%- endif -%}
      </div>

      {%- if button_label != blank -%}
        <a
          class="our-craft__cta"
          {% if button_link != blank %}
            href="{{ button_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          <span>{{ button_label }}</span>
          <span class="our-craft__cta-icon" aria-hidden="true">
            {{ 'icon-long-arrow-right.svg' | inline_asset_content }}
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .our-craft {
    color: var(--oc-text, #242027);
    background-color: var(--oc-bg, #fffdf8);
  }

  .our-craft__layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    width: 100%;
  }

  .our-craft__media {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .our-craft__primary {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 498.59 / 398.88;
    border-radius: 0 12.5rem 12.5rem 0;
    box-shadow: 0 1.625rem 3.5rem -2.125rem rgba(107, 114, 168, 0.5);
  }

  .our-craft__primary-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .our-craft__secondary {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
  }

  .our-craft__secondary-image {
    position: relative;
    flex: 0 0 10.625rem;
    width: 10.625rem;
    height: 10.625rem;
    overflow: hidden;
    border-radius: 1rem;
  }

  .our-craft__secondary-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .our-craft__stat {
    display: flex;
    flex: 0 0 6.25rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 6.25rem;
    height: 6.25rem;
    padding: 0.625rem;
    border-radius: 1rem;
    background-color: var(--oc-badge, #c8afde);
    color: var(--oc-brand, #321c41);
    text-align: center;
  }

  .our-craft__stat-number {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: 0.002em;
  }

  .our-craft__stat-label {
    margin: 0.1875rem 0 0;
    max-width: 5rem;
    font-family: var(--font-body--family);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.03125rem;
    text-transform: uppercase;
  }

  .our-craft__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;
    width: 100%;
  }

  .our-craft__copy {
    display: flex;
    flex-direction: column;
    gap: 1.5625rem;
    width: 100%;
  }

  .our-craft__title {
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
    width: 100%;
  }

  .our-craft__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.03125rem;
    text-transform: uppercase;
  }

  .our-craft__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.0125rem;
    color: inherit;
  }

  .our-craft__description {
    max-width: 30rem;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.375rem;
  }

  .our-craft__description p {
    margin: 0;
  }

  .our-craft__description p + p {
    margin-top: 1.375rem;
  }

  .our-craft__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
    border-bottom: 0.5px solid var(--oc-brand, #321c41);
    color: var(--oc-brand, #321c41);
    font-family: var(--font-accent--family, var(--font-body--family));
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    text-transform: uppercase;
  }

  .our-craft__cta[aria-disabled='true'] {
    pointer-events: none;
  }

  .our-craft__cta:focus-visible {
    outline: 2px solid var(--oc-brand, #321c41);
    outline-offset: 2px;
  }

  .our-craft__cta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
    overflow: clip;
  }

  .our-craft__cta-icon svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .our-craft__layout {
      flex-direction: row;
      align-items: center;
      gap: 3.25rem;
    }

    .our-craft__media {
      flex: 0 1 35rem;
      max-width: 35rem;
      gap: 0.9375rem;
    }

    .our-craft__secondary {
      justify-content: flex-start;
      gap: 0.9375rem;
      margin-left: -1.5625rem;
    }

    .our-craft__secondary-image {
      flex-basis: 13.5rem;
      width: 13.5rem;
      height: 13.5rem;
    }

    .our-craft__stat {
      flex-basis: 13.5rem;
      width: 13.5rem;
      height: 13.5rem;
      padding: 3.4375rem 0.625rem 4rem;
    }

    .our-craft__stat-number {
      font-size: 3.5625rem;
      font-weight: 700;
      line-height: 4.1875rem;
      letter-spacing: -0.01px;
    }

    .our-craft__stat-label {
      margin-top: 0.1875rem;
      max-width: none;
      font-size: 0.75rem;
      font-weight: 700;
      line-height: 1.5;
      letter-spacing: 0;
      text-transform: none;
    }

    .our-craft__content {
      flex: 1 1 0;
      max-width: 34.375rem;
      min-height: 25rem;
      justify-content: space-between;
      gap: 0;
      padding-top: 2.0625rem;
    }

    .our-craft__copy {
      gap: 1.5625rem;
    }

    .our-craft__description {
      max-width: 30rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.our_craft",
  "tag": "section",
  "class": "our-craft-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR CRAFT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The idea behind every portrait"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Pups Around the World began with a simple, joyful idea: every dog deserves to be the star of their own adventure. We take a single photo and reimagine your pup in the soft, dreamy style of the great impressionists, somewhere beautiful in the world.</p><p>From Paris and Provence to Venice, London and the Scottish glens, there's a scene for every character, and a few chosen with the golfers in mind. Not quite right? Try another photo or scene, free, until it's unmistakably them.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "BOOK A PORTRAIT"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Stat badge"
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Stat number",
      "default": "40+"
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Stat label",
      "default": "scenes around the world"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "primary_image",
      "label": "Primary image"
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "Secondary image"
    },
    {
      "type": "text",
      "id": "primary_image_asset",
      "label": "Primary image asset filename",
      "default": "our-craft-primary.jpg",
      "info": "Used when no primary image is selected"
    },
    {
      "type": "text",
      "id": "secondary_image_asset",
      "label": "Secondary image asset filename",
      "default": "our-craft-secondary.jpg",
      "info": "Used when no secondary image is selected"
    },
    {
      "type": "text",
      "id": "primary_image_alt",
      "label": "Primary image alt text",
      "default": "Impressionist portrait of a dog on an ornate sofa"
    },
    {
      "type": "text",
      "id": "secondary_image_alt",
      "label": "Secondary image alt text",
      "default": "Impressionist portrait of a dog by the fireplace"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#242027"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Brand",
      "default": "#321C41"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Stat badge",
      "default": "#C8AFDE"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "checkbox",
      "id": "use_mobile_padding",
      "label": "Use mobile padding",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start-mobile",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 25,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end-mobile",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 25,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.our_craft",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
