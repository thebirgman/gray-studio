{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign text_color = section.settings.text_color | default: '#F8F5FB'
  assign overlay_color = section.settings.overlay_color | default: '#242027'
  assign overlay_opacity = section.settings.overlay_opacity | default: 55
  assign rule_color = section.settings.rule_color | default: '#FFFDF8'
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign desktop_asset = section.settings.image_asset | default: 'about-approach.jpg'
  assign mobile_asset = section.settings.mobile_image_asset | default: 'about-approach-mobile.jpg'
  assign image_alt = section.settings.image_alt | default: ''
  assign overlay_opacity = overlay_opacity | times: 0.01

  if section.settings.overlay_color != blank
    assign overlay_rgb = section.settings.overlay_color.rgb
  else
    assign overlay_rgb = '36, 32, 39'
  endif
-%}

<div
  class="about-approach"
  id="AboutApproach-{{ section.id }}"
  style="
    --aa-text: {{ text_color }};
    --aa-rule: {{ rule_color }};
    --aa-overlay: {{ overlay_color }};
    --aa-overlay-rgb: {{ overlay_rgb }};
    --aa-overlay-opacity: {{ overlay_opacity }};
    --color: {{ text_color }};
    --color-foreground: {{ text_color }};
  "
>
  <div class="about-approach__media" aria-hidden="true">
    <picture>
      {%- if mobile_image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ mobile_image | image_url: width: 750 }} 750w,
            {{ mobile_image | image_url: width: 1100 }} 1100w,
            {{ mobile_image | image_url: width: 1500 }} 1500w
          "
          sizes="100vw"
        >
      {%- elsif mobile_asset != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ mobile_asset | asset_url }}"
        >
      {%- endif -%}

      {%- if desktop_image != blank -%}
        {{
          desktop_image
          | image_url: width: 2880
          | image_tag:
            class: 'about-approach__img',
            widths: '750, 1100, 1600, 2000, 2400, 2880',
            sizes: '100vw',
            loading: 'lazy',
            alt: image_alt
        }}
      {%- else -%}
        <img
          class="about-approach__img"
          src="{{ desktop_asset | asset_url }}"
          alt="{{ image_alt | escape }}"
          width="2880"
          height="1200"
          loading="lazy"
        >
      {%- endif -%}
    </picture>
    <div class="about-approach__overlay" aria-hidden="true"></div>
  </div>

  <div class="about-approach__content">
    <div class="about-approach__intro">
      {%- if eyebrow != blank -%}
        <p class="about-approach__eyebrow">{{ eyebrow }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="about-approach__heading">{{ heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="about-approach__points">
        {%- for block in section.blocks -%}
          <div class="about-approach__point" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3 class="about-approach__point-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="about-approach__point-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .about-approach-section {
    width: 100%;
  }

  .about-approach {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    box-sizing: border-box;
    width: 100%;
    min-height: 38.0625rem;
    padding: 3.75rem 1.5625rem;
    overflow: hidden;
    background-color: transparent;
    color: var(--aa-text, #f8f5fb);
  }

  .about-approach__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .about-approach__media picture,
  .about-approach__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .about-approach__img {
    object-fit: cover;
    object-position: center center;
  }

  .about-approach__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: rgb(var(--aa-overlay-rgb) / var(--aa-overlay-opacity, 0.55));
    pointer-events: none;
  }

  .about-approach__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 1.5625rem;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    padding-block: 0.625rem;
    padding-inline-start: 1.25rem;
    border-inline-start: 1px solid var(--aa-rule, #fffdf8);
  }

  .about-approach__intro {
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
  }

  .about-approach,
  .about-approach p,
  .about-approach h2,
  .about-approach h3 {
    color: var(--aa-text, #f8f5fb);
  }

  .about-approach .about-approach__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .about-approach h2.about-approach__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: normal;
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: 0.1px;
    text-transform: none;
  }

  .about-approach__points {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-approach__point {
    display: flex;
    flex-direction: column;
    gap: 0.3125rem;
  }

  .about-approach h3.about-approach__point-title {
    margin: 0;
    font-family: var(--font-body--family);
    font-style: normal;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.375rem;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .about-approach .about-approach__point-text {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.375rem;
    letter-spacing: 0;
  }

  @media screen and (min-width: 750px) {
    .about-approach {
      min-height: 37.5rem;
      justify-content: flex-end;
      padding: 5rem 0;
    }

    .about-approach__content {
      width: 50%;
      max-width: 50%;
      flex-shrink: 0;
      padding-block: 1.25rem;
      padding-inline-start: 3.75rem;
      padding-inline-end: clamp(1.5625rem, 15.486vw, 13.9375rem);
    }

    .about-approach__intro,
    .about-approach__points {
      max-width: 26.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About approach",
  "tag": "section",
  "class": "about-approach-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR APPROACH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Art first, always"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop background"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Desktop image asset filename",
      "default": "about-approach.jpg",
      "info": "Used when no desktop image is selected"
    },
    {
      "type": "text",
      "id": "mobile_image_asset",
      "label": "Mobile image asset filename",
      "default": "about-approach-mobile.jpg",
      "info": "Used when no mobile image is selected"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F8F5FB"
    },
    {
      "type": "color",
      "id": "rule_color",
      "label": "Accent rule",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#242027"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 55
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Approach point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The place matters as much as the pup"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every scene is a real destination, chosen for its light and mood, not a generic backdrop. The story is where your dog gets to go, not just how they look going there."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About approach",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "title": "The place matters as much as the pup",
            "text": "Every scene is a real destination, chosen for its light and mood, not a generic backdrop. The story is where your dog gets to go, not just how they look going there."
          }
