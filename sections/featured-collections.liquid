{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign background_color = section.settings.background_color
  assign card_bar_color = section.settings.card_bar_color
  assign accent_color = section.settings.accent_color
  assign brand_color = section.settings.brand_color

  if background_color == blank
    assign background_color = '#FFFDF8'
  endif
  if card_bar_color == blank
    assign card_bar_color = '#FAF8F0'
  endif
  if accent_color == blank
    assign accent_color = '#8855AA'
  endif
  if brand_color == blank
    assign brand_color = '#321C41'
  endif

  assign filter_blocks = section.blocks | where: 'type', 'filter'
  assign collection_blocks = section.blocks | where: 'type', 'collection'
  assign has_collection_blocks = false
  if collection_blocks.size > 0
    assign has_collection_blocks = true
  endif

  assign placeholder_titles = 'Paris,Provence,Italy,England,The Riviera,Tokyo' | split: ','
-%}

<script
  src="{{ 'featured-collections.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'contrast-override',
  background_color: background_color,
  text_color: '#242027',
  section_id: section.id,
  skip_contrast: true
%}

<div
  class="section-background color-custom-{{ section.id }}"
  style="background-color: {{ background_color }};"
></div>

<featured-collections-component
  class="
    section
    featured-collections
    color-custom-{{ section.id }}
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --fc-bg: {{ background_color }};
    --fc-text: #242027;
    --fc-muted: #605C64;
    --fc-border: #D9D6DB;
    --fc-brand: {{ brand_color }};
    --fc-accent: {{ accent_color }};
    --fc-card-bar: {{ card_bar_color }};
    --fc-on-brand: #FFFDF8;
    background-color: {{ background_color }};
  "
>
  <div class="featured-collections__layout">
    <div class="featured-collections__intro">
      <div class="featured-collections__header">
        {%- if eyebrow != blank -%}
          <p class="featured-collections__eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="featured-collections__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if description != blank -%}
          <p class="featured-collections__description">{{ description }}</p>
        {%- endif -%}
      </div>

      {%- if filter_blocks.size > 0 -%}
        <div
          class="featured-collections__filters"
          role="group"
          aria-label="{{ section.settings.filters_label | default: 'Collection filters' | escape }}"
          ref="filters"
        >
          {%- for block in filter_blocks -%}
            {%- liquid
              assign filter_value = block.settings.value | default: block.settings.label | handleize
              if filter_value == blank
                assign filter_value = 'all'
              endif
              assign is_first = forloop.first
            -%}
            <button
              type="button"
              class="featured-collections__pill{% if is_first %} is-active{% endif %}"
              data-filter="{{ filter_value | escape }}"
              aria-pressed="{% if is_first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </button>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="featured-collections__filters" ref="filters" hidden></div>
      {%- endif -%}

      {%- if button_label != blank -%}
        <div class="featured-collections__cta-wrap">
          <a
            class="featured-collections__cta"
            {% if button_link != blank %}
              href="{{ button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
          >
            <span>{{ button_label }}</span>
            <span class="featured-collections__cta-icon" aria-hidden="true">
              {{ 'icon-long-arrow-right.svg' | inline_asset_content }}
            </span>
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="featured-collections__grid" ref="grid">
      {%- if has_collection_blocks -%}
        {%- for block in collection_blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign card_title = block.settings.title
            assign scenes_label = block.settings.scenes_label
            assign category = block.settings.category | strip
            assign card_image = block.settings.image
            assign image_asset = block.settings.image_asset

            if card_title == blank and collection != blank
              assign card_title = collection.title
            endif

            if card_image == blank and collection != blank and collection.featured_image != blank
              assign card_image = collection.featured_image
            endif

            if scenes_label == blank and collection != blank
              assign scenes_count = collection.all_products_count
              assign scenes_label = scenes_count | append: ' scenes'
            endif

            if scenes_label == blank
              assign scenes_label = '10 scenes'
            endif

            if card_title == blank
              assign placeholder_index = forloop.index0 | modulo: placeholder_titles.size
              assign card_title = placeholder_titles[placeholder_index]
            endif

            if image_asset == blank and card_title != blank
              assign title_handle = card_title | handleize
              if title_handle == 'the-riviera'
                assign image_asset = 'featured-collection-riviera.jpg'
              else
                assign image_asset = 'featured-collection-' | append: title_handle | append: '.jpg'
              endif
            endif

            assign card_url = block.settings.link
            if card_url == blank and collection != blank
              assign card_url = collection.url
            endif
          -%}

          <a
            class="featured-collections__card"
            {% if card_url != blank %}
              href="{{ card_url }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
            data-category="{{ category | escape }}"
            {{ block.shopify_attributes }}
          >
            <div class="featured-collections__media">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 800
                  | image_tag:
                    class: 'featured-collections__image',
                    loading: 'lazy',
                    widths: '326, 400, 652, 800',
                    sizes: '(min-width: 750px) 326px, 80vw',
                    alt: card_title
                }}
              {%- elsif image_asset != blank -%}
                <img
                  class="featured-collections__image"
                  src="{{ image_asset | asset_url }}"
                  alt="{{ card_title | escape }}"
                  width="800"
                  height="800"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'featured-collections__image featured-collections__image--placeholder' }}
              {%- endif -%}
            </div>
            <div class="featured-collections__bar">
              <span class="featured-collections__card-title">{{ card_title }}</span>
              <span class="featured-collections__scenes">{{ scenes_label }}</span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for title in placeholder_titles -%}
          {%- liquid
            assign title_handle = title | handleize
            if title_handle == 'the-riviera'
              assign image_asset = 'featured-collection-riviera.jpg'
            else
              assign image_asset = 'featured-collection-' | append: title_handle | append: '.jpg'
            endif
          -%}
          <div class="featured-collections__card" data-category="all" aria-hidden="true">
            <div class="featured-collections__media">
              <img
                class="featured-collections__image"
                src="{{ image_asset | asset_url }}"
                alt=""
                width="800"
                height="800"
                loading="lazy"
              >
            </div>
            <div class="featured-collections__bar">
              <span class="featured-collections__card-title">{{ title }}</span>
              <span class="featured-collections__scenes">10 scenes</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</featured-collections-component>

{% stylesheet %}
  .featured-collections {
    color: var(--fc-text);
  }

  .featured-collections__layout {
    display: flex;
    flex-direction: column;
    gap: 1.5625rem;
    width: 100%;
    min-width: 0;
  }

  .featured-collections__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5625rem;
    width: 100%;
    text-align: center;
  }

  .featured-collections__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9375rem;
    width: 100%;
  }

  .featured-collections__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.03125rem;
    text-transform: uppercase;
    color: var(--fc-text);
  }

  .featured-collections__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 2.25rem;
    letter-spacing: 0;
    color: var(--fc-text);
  }

  .featured-collections__description {
    margin: 0;
    max-width: 28.8125rem;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.375rem;
    color: var(--fc-text);
  }

  .featured-collections__filters {
    display: flex;
    gap: 0.875rem;
    align-items: center;
    align-self: flex-start;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .featured-collections__filters::-webkit-scrollbar {
    display: none;
  }

  .featured-collections__pill {
    appearance: none;
    flex-shrink: 0;
    margin: 0;
    padding: 0.5625rem 1.125rem;
    border: 1.5px solid var(--fc-border);
    border-radius: 1.25rem;
    background: var(--fc-bg);
    color: var(--fc-muted);
    font-family: var(--font-body--family);
    font-size: 0.84375rem;
    font-weight: 700;
    line-height: normal;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .featured-collections__pill.is-active,
  .featured-collections__pill[aria-pressed='true'] {
    background: var(--fc-brand);
    border-color: var(--fc-brand);
    color: var(--fc-on-brand);
  }

  .featured-collections__pill:focus-visible {
    outline: 2px solid var(--fc-brand);
    outline-offset: 2px;
  }

  .featured-collections__cta-wrap {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .featured-collections__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.25rem 0;
    border-bottom: 0.5px solid var(--fc-brand);
    color: var(--fc-brand);
    text-decoration: none;
    font-family: var(--font-button--family, var(--font-body--family));
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .featured-collections__cta[aria-disabled='true'] {
    pointer-events: none;
  }

  .featured-collections__cta-icon {
    display: inline-flex;
    width: 1.125rem;
    height: 1.125rem;
    overflow: clip;
    align-items: center;
    justify-content: center;
  }

  .featured-collections__cta-icon svg {
    width: 100%;
    height: 100%;
  }

  .featured-collections__grid {
    display: flex;
    gap: 0.625rem;
    width: 100%;
    padding-block-end: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
  }

  .featured-collections__grid::-webkit-scrollbar {
    display: none;
  }

  .featured-collections__card {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 0 0 20.375rem;
    width: 20.375rem;
    height: 25rem;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    scroll-snap-align: start;
  }

  .featured-collections__card[hidden],
  .featured-collections__card.is-filtered-out {
    display: none;
  }

  .featured-collections__card[aria-disabled='true'] {
    pointer-events: none;
  }

  .featured-collections__media {
    position: absolute;
    inset: 0;
  }

  .featured-collections__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .featured-collections__image--placeholder {
    background: #e8e4dc;
  }

  .featured-collections__bar {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.5rem;
    padding: 0 1rem;
    border-radius: 0.3125rem;
    background: var(--fc-card-bar);
  }

  .featured-collections__card-title {
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--fc-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .featured-collections__scenes {
    flex-shrink: 0;
    font-family: var(--font-body--family);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.03125rem;
    text-transform: uppercase;
    text-align: right;
    color: var(--fc-accent);
  }

  .featured-collections__filters::after,
  .featured-collections__grid::after {
    content: '';
    flex: 0 0 calc(
      var(--padding-inline-end-mobile, var(--padding-inline-end, 0px)) + var(--page-margin, 0px)
    );
  }

  @media screen and (max-width: 749px) {
    .featured-collections.spacing-style {
      padding-inline-end: 0;
    }

    .featured-collections > .featured-collections__layout {
      grid-column: 2 / -1;
    }

    .featured-collections__header,
    .featured-collections__cta-wrap {
      padding-inline-end: calc(
        var(--padding-inline-end-mobile, var(--padding-inline-end, 0px)) + var(--page-margin, 0px)
      );
    }
  }

  @media screen and (min-width: 750px) {
    .featured-collections__layout {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .featured-collections__intro {
      position: sticky;
      top: calc(var(--header-height, 0px) + 1.5rem);
      width: 30.25rem;
      max-width: 40%;
      height: 25rem;
      justify-content: center;
      flex-shrink: 0;
      gap: 1.5625rem;
    }

    .featured-collections__heading {
      font-size: 2.5rem;
      line-height: 1.08;
      letter-spacing: -0.0125rem;
    }

    .featured-collections__filters {
      align-self: center;
      justify-content: center;
      width: auto;
      max-width: 100%;
      overflow: visible;
      flex-wrap: wrap;
      gap: 0.625rem;
    }

    .featured-collections__filters::after,
    .featured-collections__grid::after {
      content: none;
    }

    .featured-collections__grid {
      display: grid;
      grid-template-columns: repeat(2, 20.375rem);
      gap: 0.625rem;
      width: auto;
      max-width: 41.375rem;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .featured-collections__card {
      flex: none;
      width: 20.375rem;
      scroll-snap-align: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collections",
  "tag": "section",
  "class": "featured-collections-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "filter",
      "name": "Filter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All destinations"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "all",
          "info": "Use \"all\" to show every card. Otherwise match a collection card category."
        }
      ]
    },
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Defaults to the collection image, then the asset below."
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Fallback image asset",
          "info": "Theme asset filename, e.g. featured-collection-paris.jpg"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Optional. Defaults to the collection title."
        },
        {
          "type": "text",
          "id": "scenes_label",
          "label": "Scenes label",
          "default": "10 scenes"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category",
          "info": "Match a filter value, e.g. playful. Comma-separate for multiple."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Defaults to the collection URL."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DISCOVER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our collections"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every scene is an original piece of art. Upload your pup's photo, customize the setting, and select a frame and size. Free to preview, always."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See all 40+ scenes"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "filters_label",
      "label": "Filters accessibility label",
      "default": "Collection filters"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "brand_color",
      "label": "Brand",
      "default": "#321C41"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#8855AA"
    },
    {
      "type": "color",
      "id": "card_bar_color",
      "label": "Card label bar",
      "default": "#FAF8F0"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Mobile padding"
    },
    {
      "type": "checkbox",
      "id": "use_mobile_padding",
      "label": "Use mobile padding",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 25,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start-mobile",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 25,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
