          "type": "filter",
          "settings": {
            "label": "Playful",
            "value": "playful"
          }
        },
        {
          "type": "filter",
          "settings": {
            "label": "Elegant",
            "value": "elegant"
          }
        },
        {
          "type": "filter",
          "settings": {
            "label": "Cosy",
            "value": "cosy"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Paris",
            "scenes_label": "10 scenes",
            "category": "elegant"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Provence",
            "scenes_label": "10 scenes",
            "category": "playful"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Italy",
            "scenes_label": "10 scenes",
            "category": "cosy"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "England",
            "scenes_label": "10 scenes",
            "category": "elegant"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "The Riviera",
            "scenes_label": "10 scenes",
            "category": "playful"
          }
        },
        {
          "type": "collection",
