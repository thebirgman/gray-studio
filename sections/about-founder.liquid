{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign greeting = section.settings.greeting
  assign letter = section.settings.letter
  assign signature = section.settings.signature
  assign panel_color = section.settings.panel_color | default: '#321C41'
  assign text_color = section.settings.text_color | default: '#F8F5FB'
  assign page_color = section.settings.page_color | default: '#FFFDF8'
  assign desktop_image = section.settings.desktop_image | default: section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign desktop_asset = section.settings.desktop_image_asset | default: section.settings.image_asset | default: 'about-founder.jpg'
  assign mobile_asset = section.settings.mobile_image_asset | default: 'about-founder-mobile.jpg'
  assign image_alt = section.settings.image_alt | default: 'Kathryn Gray'
  assign has_mobile_media = false
  if mobile_image != blank or mobile_asset != blank
    assign has_mobile_media = true
  endif
  assign desktop_image_class = 'about-founder__img'
  if has_mobile_media
    assign desktop_image_class = 'about-founder__img about-founder__img--desktop'
  endif
-%}

{% render 'contrast-override',
  background_color: panel_color,
  text_color: text_color,
  section_id: section.id
%}

<div
  class="about-founder"
  id="AboutFounder-{{ section.id }}"
  style="
    --af-page: {{ page_color }};
    --af-panel: {{ panel_color }};
    --af-text: {{ text_color }};
  "
>
  <div class="about-founder__inner">
    <div class="about-founder__media">
      {%- if desktop_image != blank -%}
        {{
          desktop_image
          | image_url: width: 1600
          | image_tag:
            class: desktop_image_class,
            widths: '600, 800, 1200, 1600',
            sizes: '(min-width: 750px) min(600px, 50vw), calc(100vw - 22px)',
            loading: 'lazy',
            alt: image_alt
        }}
      {%- else -%}
        <img
          class="{{ desktop_image_class }}"
          src="{{ desktop_asset | asset_url }}"
          alt="{{ image_alt | escape }}"
          width="1200"
          height="1200"
          loading="lazy"
        >
      {%- endif -%}

      {%- if has_mobile_media -%}
        {%- if mobile_image != blank -%}
          {{
            mobile_image
            | image_url: width: 1104
            | image_tag:
              class: 'about-founder__img about-founder__img--mobile',
              widths: '736, 1104',
              sizes: 'calc(100vw - 22px)',
              loading: 'lazy',
              alt: image_alt
          }}
        {%- else -%}
          <img
            class="about-founder__img about-founder__img--mobile"
            src="{{ mobile_asset | asset_url }}"
            alt="{{ image_alt | escape }}"
            width="736"
            height="1200"
            loading="lazy"
          >
        {%- endif -%}
      {%- endif -%}
    </div>

    <div class="about-founder__panel color-custom-{{ section.id }}">
      <div class="about-founder__content">
        {%- if eyebrow != blank or greeting != blank -%}
          <div class="about-founder__intro">
            {%- if eyebrow != blank -%}
              <p class="about-founder__eyebrow">{{ eyebrow }}</p>
            {%- endif -%}
            {%- if greeting != blank -%}
              <h2 class="about-founder__greeting">{{ greeting }}</h2>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if letter != blank -%}
          <div class="about-founder__letter rte">{{ letter }}</div>
        {%- endif -%}
        {%- if signature != blank -%}
          <p class="about-founder__signature">{{ signature }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .about-founder {
    width: 100%;
    background-color: var(--af-page, #fffdf8);
    padding: 3.75rem 0 0;
  }

  .about-founder__inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: calc(100% - 1.375rem);
    max-width: 75.9375rem;
    margin-inline: auto;
  }

  .about-founder__media {
    position: relative;
    width: 100%;
    aspect-ratio: 368 / 600;
    overflow: hidden;
  }

  .about-founder__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-founder__img--desktop {
    display: none;
  }

  .about-founder__img--mobile {
    display: block;
  }

  .about-founder__panel {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 36.3125rem;
    background-color: var(--af-panel, #321c41);
    color: var(--af-text, #f8f5fb);
    padding: 1.25rem 0.9375rem;
  }

  .about-founder__content {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    max-width: 26.5rem;
  }

  .about-founder__intro {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    align-items: flex-start;
  }

  .about-founder__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.03125rem;
    text-transform: uppercase;
  }

  .about-founder__greeting {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: 0.032px;
    color: inherit;
  }

  .about-founder__letter {
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.375rem;
  }

  .about-founder__letter > *:first-child {
    margin-block-start: 0;
  }

  .about-founder__letter > *:last-child {
    margin-block-end: 0;
  }

  .about-founder__letter p {
    margin: 0 0 1.375rem;
  }

  .about-founder__letter p:last-child {
    margin-bottom: 0;
  }

  .about-founder__signature {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.25;
  }

  @media screen and (min-width: 750px) {
    .about-founder {
      padding: 5rem clamp(1.5rem, 8.33vw, 7.5rem) 0;
    }

    .about-founder__inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.9375rem;
      width: 100%;
      align-items: stretch;
    }

    .about-founder__media {
      order: 2;
      aspect-ratio: 1 / 1;
    }

    .about-founder__img--desktop {
      display: block;
    }

    .about-founder__img--mobile {
      display: none;
    }

    .about-founder__panel {
      order: 1;
      aspect-ratio: 1 / 1;
      min-height: 0;
      height: auto;
      padding: 1.75rem 14.666% 1.4375rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About founder note",
  "tag": "section",
  "class": "about-founder-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A note from the founder"
    },
    {
      "type": "text",
      "id": "greeting",
      "label": "Greeting",
      "default": "Dear friend,"
    },
    {
      "type": "richtext",
      "id": "letter",
      "label": "Letter",
      "default": "<p>I started Pups Around the World because I've spent twenty-five years painting people's favorite places, and somewhere along the way I noticed the thing missing from most portraits wasn't the person. It was their dog.</p><p>I curate every scene in this collection myself, the palette, the light, the mood, long before your pup ever steps into it. Paris isn't Paris because a prompt said so. It's Paris because I know what that light actually looks like in the evening, and I wanted your dog standing in it.</p><p>I still believe the artist should lead and the tools should follow, not the other way around. That's the whole idea behind every portrait here: your dog, painted the way I'd paint anyone I loved, somewhere I'd want to send them.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "~ Kathryn Gray"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Shown below 750px. Uses the desktop image if none is selected."
    },
    {
      "type": "text",
      "id": "desktop_image_asset",
      "label": "Desktop image asset filename",
      "default": "about-founder.jpg",
      "info": "Used when no desktop image is selected"
    },
    {
      "type": "text",
      "id": "mobile_image_asset",
      "label": "Mobile image asset filename",
      "default": "about-founder-mobile.jpg",
      "info": "Used when no mobile image is selected"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Kathryn Gray"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "page_color",
      "label": "Page background",
      "default": "#FFFDF8"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Panel background",
      "default": "#321C41"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F8F5FB"
    }
  ],
  "presets": [
    {
      "name": "About founder note",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
