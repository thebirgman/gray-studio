{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign background_color = section.settings.background_color | default: '#F2F7FC'
  assign text_color = section.settings.text_color | default: '#242027'
  assign muted_color = section.settings.muted_color | default: '#605C64'
  assign card_border = section.settings.card_border | default: '#C9DEF4'
  assign button_color = section.settings.button_color | default: '#212C4A'
  assign marquee_color = section.settings.marquee_color | default: '#C9DEF4'
  assign marquee_text = section.settings.marquee_text | default: 'Soft impressionist style   ·   Free preview, always   ·   Ships worldwide   ·   Scenes from around the world'
  assign star_asset = section.settings.star_asset | default: 'testimonials-star.svg'
-%}

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Alex+Brush&display=swap"
  media="print"
  onload="this.media='all'"
>
<noscript>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alex+Brush&display=swap">
</noscript>

<script
  src="{{ 'testimonials.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'contrast-override',
  background_color: background_color,
  text_color: text_color,
  section_id: section.id,
  skip_contrast: true
%}

<testimonials-component
  class="testimonials color-custom-{{ section.id }}"
  id="Testimonials-{{ section.id }}"
  style="
    --testimonials-bg: {{ background_color }};
    --testimonials-text: {{ text_color }};
    --testimonials-muted: {{ muted_color }};
    --testimonials-border: {{ card_border }};
    --testimonials-button: {{ button_color }};
    --testimonials-marquee: {{ marquee_color }};
    background-color: {{ background_color }};
  "
>
  <div class="testimonials__intro">
    <div class="testimonials__copy">
      {%- if eyebrow != blank -%}
        <p class="testimonials__eyebrow">{{ eyebrow }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="testimonials__heading">{{ heading }}</h2>
      {%- endif -%}
    </div>

    {%- if marquee_text != blank -%}
      <div class="testimonials__marquee" aria-hidden="true">
        <div class="testimonials__marquee-track">
          <p class="testimonials__marquee-text">{{ marquee_text }}&nbsp;&nbsp;·&nbsp;&nbsp;</p>
          <p class="testimonials__marquee-text">{{ marquee_text }}&nbsp;&nbsp;·&nbsp;&nbsp;</p>
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="testimonials__body">
    <div
      class="testimonials__track"
      ref="track"
      role="list"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign rating = block.settings.rating | default: 5 | plus: 0
          if rating < 1
            assign rating = 1
          endif
          if rating > 5
            assign rating = 5
          endif
        -%}
        <article
          class="testimonials__card"
          data-testimonial-card
          role="listitem"
          {{ block.shopify_attributes }}
        >
          <div class="testimonials__stars" aria-label="{{ rating }} out of 5 stars">
            {%- for i in (1..rating) -%}
              <span class="testimonials__star" aria-hidden="true">
                <img
                  class="testimonials__star-img"
                  src="{{ star_asset | asset_url }}"
                  alt=""
                  width="10"
                  height="10"
                  loading="lazy"
                >
              </span>
            {%- endfor -%}
          </div>

          {%- if block.settings.quote != blank -%}
            <p class="testimonials__quote">{{ block.settings.quote }}</p>
          {%- endif -%}

          <div class="testimonials__reviewer">
            {%- if block.settings.author != blank -%}
              <p class="testimonials__author">{{ block.settings.author }}</p>
            {%- endif -%}
            {%- if block.settings.meta != blank -%}
              <p class="testimonials__meta">{{ block.settings.meta }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div
        class="testimonials__dots"
        ref="dots"
        role="tablist"
        aria-label="{{ section.settings.dots_label | default: 'Review slides' | escape }}"
      ></div>
    {%- endif -%}

    {%- if button_label != blank -%}
      <a
        class="testimonials__button"
        {% if button_link != blank %}
          href="{{ button_link }}"
        {% else %}
          role="link"
          aria-disabled="true"
        {% endif %}
      >
        {{ button_label }}
      </a>
    {%- endif -%}
  </div>
</testimonials-component>

{% stylesheet %}
  .testimonials {
    --testimonials-pad-x: 1.5625rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
    padding: 3.75rem 0 2.1875rem;
    color: var(--testimonials-text, #242027);
    background-color: var(--testimonials-bg, #f2f7fc);
    overflow-x: clip;
  }

  .testimonials__intro {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .testimonials__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3125rem;
    margin-bottom: -5rem;
    padding-inline: var(--testimonials-pad-x);
    text-align: center;
    color: var(--testimonials-text, #242027);
  }

  .testimonials__eyebrow {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.03125rem;
    text-transform: uppercase;
  }

  .testimonials__heading {
    margin: 0;
    max-width: 21.125rem;
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 2.25rem;
    letter-spacing: 0;
    color: inherit;
  }

  .testimonials__marquee {
    position: relative;
    z-index: 0;
    width: 100%;
    height: 8.125rem;
    overflow: hidden;
    pointer-events: none;
  }

  .testimonials__marquee-track {
    display: flex;
    width: max-content;
    height: 100%;
    align-items: center;
  }

  .testimonials__marquee-text {
    margin: 0;
    flex-shrink: 0;
    font-family: 'Alex Brush', cursive;
    font-size: 8.6875rem;
    font-weight: 400;
    line-height: 1;
    color: var(--testimonials-marquee, #c9def4);
    opacity: 0.35;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .testimonials__marquee-track {
      animation: testimonials-marquee 100s linear infinite;
    }
  }

  @keyframes testimonials-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .testimonials__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    padding-inline: var(--testimonials-pad-x);
  }

  .testimonials__track {
    display: flex;
    gap: 1.5rem;
    align-items: stretch;
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .testimonials__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    flex: 0 0 min(21.5625rem, calc(100vw - 3.125rem));
    width: min(21.5625rem, calc(100vw - 3.125rem));
    max-width: 21.5625rem;
    padding: 1.875rem 1.625rem;
    border: 1px solid var(--testimonials-border, #c9def4);
    border-radius: 1.25rem;
    background: #fff;
    scroll-snap-align: center;
    overflow: clip;
  }

  .testimonials__stars {
    display: flex;
    gap: 0.1875rem;
    align-items: center;
  }

  .testimonials__star {
    display: block;
    width: 0.625rem;
    height: 0.625rem;
    overflow: clip;
    flex-shrink: 0;
  }

  .testimonials__star-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .testimonials__quote {
    margin: 0;
    width: 100%;
    max-width: 18.3125rem;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-style: italic;
    font-weight: 400;
    line-height: 1.375rem;
    text-align: center;
    color: var(--testimonials-text, #242027);
  }

  .testimonials__reviewer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    overflow: clip;
  }

  .testimonials__author {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.25rem;
    color: var(--testimonials-text, #242027);
    white-space: nowrap;
  }

  .testimonials__meta {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.4375rem;
    font-weight: 400;
    line-height: 0.9375rem;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--testimonials-muted, #605c64);
    white-space: nowrap;
  }

  .testimonials__dots {
    display: flex;
    gap: 0.6875rem;
    align-items: center;
    justify-content: center;
    height: 0.4375rem;
  }

  .testimonials__dot {
    appearance: none;
    margin: 0;
    padding: 0;
    width: 0.4375rem;
    height: 0.4375rem;
    border: 0.5px solid var(--testimonials-button, #212c4a);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .testimonials__dot[aria-current='true'] {
    border-color: transparent;
    background: var(--testimonials-button, #212c4a);
  }

  .testimonials__dot:focus-visible {
    outline: 2px solid var(--testimonials-button, #212c4a);
    outline-offset: 2px;
  }

  .testimonials__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border: 0.5px solid var(--testimonials-button, #212c4a);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--testimonials-button, #212c4a);
    font-family: var(--font-accent--family, var(--font-body--family));
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.03em;
    text-decoration: none;
    text-align: center;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .testimonials__button:hover {
    background-color: var(--testimonials-button, #212c4a);
    color: #fff;
  }

  .testimonials__button[aria-disabled='true'] {
    pointer-events: none;
  }

  .testimonials__button:focus-visible {
    outline: 2px solid var(--testimonials-button, #212c4a);
    outline-offset: 2px;
  }

  @media screen and (min-width: 750px) {
    .testimonials {
      --testimonials-pad-x: 8.125rem;
      gap: 1.5625rem;
      padding: 5rem 0 2.1875rem;
    }

    .testimonials__copy {
      margin-bottom: -3.75rem;
    }

    .testimonials__heading {
      max-width: 33.75rem;
      font-size: 2.5rem;
      line-height: 1.08;
      letter-spacing: -0.0125rem;
    }

    .testimonials__body {
      gap: 1.5625rem;
    }

    .testimonials__track {
      justify-content: center;
      overflow: visible;
      scroll-snap-type: none;
    }

    .testimonials__card {
      flex: 0 0 21.5625rem;
      width: 21.5625rem;
    }

    .testimonials__dots {
      display: none;
    }
  }
{% endstylesheet %}

