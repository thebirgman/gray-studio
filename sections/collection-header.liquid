{%- liquid
  assign title = section.settings.title | default: collection.title
  assign short_description = collection.metafields.custom.short_description.value
  assign full_description = collection.description
  assign learn_more_label = section.settings.learn_more_label | default: 'Learn more'
  assign show_less_label = section.settings.show_less_label | default: 'Show less'
  assign filter_label = section.settings.filter_label | default: 'Filter by city'
  assign show_filter_button = section.settings.show_filter_button
  assign breadcrumb_home = section.settings.breadcrumb_home | default: 'Home'
  assign breadcrumb_current = section.settings.breadcrumb_current | default: 'Collection'

  if section.settings.description != blank
    assign preview_description = section.settings.description
  elsif short_description != blank
    assign preview_description = short_description
  else
    assign preview_description = full_description
  endif

  assign has_expandable = false
  assign expand_description = full_description
  if expand_description == blank
    assign expand_description = preview_description
  endif
  if expand_description != blank and preview_description != blank
    assign preview_plain = preview_description | strip_html | strip
    assign expand_plain = expand_description | strip_html | strip
    if expand_plain != blank and expand_plain != preview_plain
      assign has_expandable = true
    elsif expand_plain.size > 220
      assign has_expandable = true
    endif
  endif

  assign filter_blocks = section.blocks | where: 'type', 'destination'
  assign total_active_values = 0
  for filter in collection.filters
    case filter.type
      when 'price_range'
        if filter.min_value.value != null or filter.max_value.value != null
          assign total_active_values = total_active_values | plus: 1
        endif
      when 'boolean'
        if filter.active_values[0].value
          assign total_active_values = total_active_values | plus: 1
        endif
      else
        assign total_active_values = total_active_values | plus: filter.active_values.size
    endcase
  endfor
-%}

<script
  src="{{ 'collection-header.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'contrast-override',
  background_color: section.settings.background_color,
  text_color: '#242027',
  section_id: section.id,
  skip_contrast: true
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  {% if section.settings.background_color != blank %}
    style="background-color: {{ section.settings.background_color }};"
  {% endif %}
></div>

<collection-header-component
  class="
    section
    section--page-width
    collection-header
    spacing-style
    {% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    --ch-bg: {{ section.settings.background_color | default: '#ffffff' }};
    --ch-text: #242027;
    --ch-muted: #605c64;
    --ch-border: #d9d6db;
    --ch-brand: #321c41;
    --ch-on-brand: #fffdf8;
    --ch-charcoal: #121212;
  "
  data-expanded="false"
>
  <div class="collection-header__inner">
  <nav class="collection-header__breadcrumbs" aria-label="{{ 'accessibility.breadcrumbs' | t }}">
    <ol class="collection-header__breadcrumb-list">
      <li class="collection-header__breadcrumb-item">
        <a class="collection-header__breadcrumb-link" href="{{ routes.root_url }}">{{ breadcrumb_home | escape }}</a>
      </li>
      <li class="collection-header__breadcrumb-item" aria-current="page">
        <span class="collection-header__breadcrumb-current">{{ breadcrumb_current | escape }}</span>
      </li>
    </ol>
  </nav>

  <div class="collection-header__intro">
    {%- if title != blank -%}
      <h1 class="collection-header__title">{{ title | escape }}</h1>
    {%- endif -%}

    {%- if preview_description != blank or full_description != blank -%}
      <div class="collection-header__description-wrap">
        <div
          class="collection-header__description"
          data-description
          {% unless has_expandable %}
            data-always-open="true"
          {% endunless %}
        >
          <div class="collection-header__description-preview rte" data-description-preview>
            {{ preview_description }}
          </div>
          {%- if has_expandable -%}
            <div class="collection-header__description-full rte" data-description-full hidden>
              {{ expand_description }}
            </div>
          {%- endif -%}
        </div>

        {%- if has_expandable -%}
          <button
            type="button"
            class="collection-header__learn-more"
            data-learn-more
            aria-expanded="false"
          >
            <span data-learn-more-label>{{ learn_more_label | escape }}</span>
            <span class="collection-header__learn-more-icon" aria-hidden="true">
              {{ 'pdp-collection-chevron.svg' | inline_asset_content }}
            </span>
          </button>
          <span class="visually-hidden" data-show-less-label>{{ show_less_label | escape }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if filter_blocks.size > 0 or show_filter_button -%}
    <div class="collection-header__toolbar">
      {%- if filter_blocks.size > 0 -%}
        <div
          class="collection-header__pills"
          role="navigation"
          aria-label="{{ section.settings.pills_label | default: 'Destinations' | escape }}"
        >
          {%- for block in filter_blocks -%}
            {%- liquid
              assign pill_label = block.settings.label
              assign pill_collection = block.settings.collection
              assign pill_url = block.settings.link
              if pill_url == blank and pill_collection != blank
                assign pill_url = pill_collection.url
              endif
              if pill_label == blank and pill_collection != blank
                assign pill_label = pill_collection.title
              endif

              assign is_active = false
              if pill_collection != blank and pill_collection.handle == collection.handle
                assign is_active = true
              elsif pill_url == blank and forloop.first
                assign is_active = true
              elsif pill_url == collection.url
                assign is_active = true
              endif
            -%}
            {%- if pill_label != blank -%}
              {%- if pill_url != blank -%}
                <a
                  class="collection-header__pill{% if is_active %} is-active{% endif %}"
                  href="{{ pill_url }}"
                  {% if is_active %}
                    aria-current="page"
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  {{ pill_label | escape }}
                </a>
              {%- else -%}
                <span
                  class="collection-header__pill{% if is_active %} is-active{% endif %}"
                  {% if is_active %}
                    aria-current="page"
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  {{ pill_label | escape }}
                </span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if show_filter_button -%}
        <button
          type="button"
          class="collection-header__filter-btn"
          on:click="#filters-drawer/open"
          aria-haspopup="dialog"
        >
          <span class="collection-header__filter-leading">
            <span class="collection-header__filter-icon" aria-hidden="true">
              {{ 'icon-filter.svg' | inline_asset_content }}
            </span>
            <span class="collection-header__filter-label">{{ filter_label | escape }}</span>
            {%- if total_active_values > 0 -%}
              <span class="collection-header__filter-count" aria-hidden="true">{{ total_active_values }}</span>
              <span class="visually-hidden">
                {{ 'accessibility.filter_count' | t: count: total_active_values }}
              </span>
            {%- endif -%}
          </span>
          <span class="collection-header__filter-caret" aria-hidden="true">
            {{ 'pdp-collection-chevron.svg' | inline_asset_content }}
          </span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
  </div>
</collection-header-component>

{% stylesheet %}
  /* Keep .section display:grid for page-width. Flex lives on the inner wrapper. */
  .collection-header {
    width: 100%;
    color: var(--ch-text);
  }

  .collection-header__inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .collection-header__inner {
      gap: 1.25rem;
    }

    .collection-header__toolbar {
      margin-block-end: 0;
    }
  }

  .collection-header__breadcrumbs {
    width: 100%;
  }

  .collection-header__breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body--family);
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.375rem;
    color: var(--ch-muted);
  }

  .collection-header__breadcrumb-item:not(:last-child)::after {
    content: '|';
    margin-inline-start: 0.35rem;
    color: var(--ch-muted);
  }

  .collection-header__breadcrumb-link {
    color: inherit;
    text-decoration: none;
  }

  .collection-header__breadcrumb-link:hover {
    text-decoration: underline;
  }

  .collection-header__breadcrumb-current {
    color: inherit;
  }

  .collection-header__intro {
    display: flex;
    flex-direction: column;
    gap: 0.9375rem;
    max-width: 45.8125rem;
  }

  .collection-header__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 2.75rem;
    letter-spacing: -0.0036px;
    color: var(--ch-charcoal);
  }

  .collection-header__description-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.9375rem;
    align-items: flex-start;
  }

  .collection-header__description {
    width: 100%;
  }

  .collection-header__description-preview,
  .collection-header__description-full {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.375rem;
    color: var(--ch-charcoal);
  }

  .collection-header__description-preview p,
  .collection-header__description-full p {
    margin: 0 0 0.75rem;
  }

  .collection-header__description-preview p:last-child,
  .collection-header__description-full p:last-child {
    margin-bottom: 0;
  }

  .collection-header__description:not([data-always-open='true']):not([data-open='true']) .collection-header__description-preview {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .collection-header__learn-more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ch-text);
    font-family: var(--font-body--family);
    font-size: 0.78125rem;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .collection-header__learn-more-icon {
    display: inline-flex;
    width: 0.625rem;
    height: 0.375rem;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .collection-header__learn-more-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .collection-header[data-expanded='true'] .collection-header__learn-more-icon {
    transform: rotate(180deg);
  }

  .collection-header__toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
  }

  .collection-header__pills {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .collection-header__pills::-webkit-scrollbar {
    display: none;
  }

  .collection-header__pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 0.5625rem 1.25rem;
    border: 1.5px solid var(--ch-border);
    border-radius: 1.25rem;
    background: transparent;
    color: var(--ch-muted);
    font-family: var(--font-body--family);
    font-size: 0.84375rem;
    font-weight: 700;
    line-height: normal;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .collection-header__pill.is-active,
  .collection-header__pill[aria-current='page'] {
    background: var(--ch-brand);
    border-color: var(--ch-brand);
    color: var(--ch-on-brand);
  }

  .collection-header__pill:focus-visible {
    outline: 2px solid var(--ch-brand);
    outline-offset: 2px;
  }

  .collection-header__filter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    min-height: 2.375rem;
    margin: 0;
    padding: 0.25rem 1.25rem;
    border: 0.5px solid var(--ch-text);
    border-radius: 999px;
    background: transparent;
    color: var(--ch-muted);
    font-family: var(--font-body--family);
    font-size: 0.84375rem;
    font-weight: 700;
    line-height: 1.1375rem;
    cursor: pointer;
  }

  .collection-header__filter-leading {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }

  .collection-header__filter-icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--ch-muted);
  }

  .collection-header__filter-icon svg {
    width: 100%;
    height: 100%;
  }

  .collection-header__filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1rem;
    height: 1rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background: var(--ch-brand);
    color: var(--ch-on-brand);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.1375rem;
  }

  .collection-header__filter-caret {
    display: inline-flex;
    width: 0.625rem;
    height: 0.375rem;
    margin-inline-start: auto;
    flex-shrink: 0;
  }

  .collection-header__filter-caret svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .collection-header__breadcrumb-list {
      font-size: 0.9375rem;
    }

    .collection-header__toolbar {
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: flex-start;
      gap: 0.625rem;
    }

    .collection-header__pills {
      width: auto;
      flex: 0 1 auto;
      min-width: 0;
    }

    .collection-header__filter-btn {
      width: auto;
      flex: 0 0 auto;
      justify-content: center;
      min-height: 2.125rem;
      margin-inline-start: 0;
    }

    .collection-header__filter-caret {
      margin-inline-start: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .collection-header__title {
      font-size: 1.75rem;
      line-height: 2.25rem;
    }

    .collection-header__description-preview,
    .collection-header__description-full {
      font-size: 0.875rem;
      line-height: 1.25rem;
    }

    .collection-header__breadcrumb-list {
      font-size: 0.625rem;
      line-height: normal;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection header",
  "tag": "section",
  "class": "collection-header-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "blocks": [
    {
      "type": "destination",
      "name": "Destination pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "All destinations"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Overrides the collection link when set."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Preview description",
      "info": "Shown when collapsed. Falls back to the collection short description metafield, then the full description."
    },
    {
      "type": "text",
      "id": "learn_more_label",
      "label": "Learn more label",
      "default": "Learn more"
    },
    {
      "type": "text",
      "id": "show_less_label",
      "label": "Show less label",
      "default": "Show less"
    },
    {
      "type": "header",
      "content": "Breadcrumbs"
    },
    {
      "type": "text",
      "id": "breadcrumb_home",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_current",
      "label": "Current label",
      "default": "Collection"
    },
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "text",
      "id": "pills_label",
      "label": "Destination pills label",
      "default": "Destinations"
    },
    {
      "type": "checkbox",
      "id": "show_filter_button",
      "label": "Show filter by city button",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter button label",
      "default": "Filter by city"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collection header",
      "blocks": [
        {
          "type": "destination",
          "settings": {
            "label": "All destinations"
          }
        },
        {
          "type": "destination",
          "settings": {
            "label": "City & landmarks"
          }
        },
        {
          "type": "destination",
          "settings": {
            "label": "Coastal & lakeside"
          }
        },
        {
          "type": "destination",
          "settings": {
            "label": "Countryside & gardens"
          }
        },
        {
          "type": "destination",
          "settings": {
            "label": "Cozy & fireside"
          }
        }
      ]
    }
  ]
}
{% endschema %}
