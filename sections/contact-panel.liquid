{%- liquid
  assign heading = section.settings.heading
  assign intro = section.settings.intro
  assign button_label = section.settings.button_label
  assign show_paw_icons = section.settings.show_paw_icons
  assign show_button_icon = section.settings.show_button_icon

  assign placeholder_name = section.settings.placeholder_name
  assign placeholder_email = section.settings.placeholder_email
  assign placeholder_phone = section.settings.placeholder_phone
  assign placeholder_message = section.settings.placeholder_message

  assign background_image = section.settings.background_image
  assign inset_image = section.settings.inset_image
  assign inset_alt = section.settings.inset_image_alt | default: heading

  assign aside_background = section.settings.aside_background | default: '#321C41'
  assign aside_text = section.settings.aside_text | default: '#F8F5FB'
  assign panel_background = section.settings.panel_background | default: '#E8DFF1'
  assign text_color = section.settings.text_color | default: '#242027'
  assign input_background = section.settings.input_background | default: '#F4EEF9'
  assign placeholder_color = section.settings.placeholder_color | default: '#918D95'
  assign button_color = section.settings.button_color | default: '#321C41'
  assign button_hover_text = section.settings.button_hover_text | default: '#FFFDF8'

  assign form_id = section.id | prepend: 'ContactPanel-'
-%}

{%- style -%}
  {{ settings.type_button_font | font_face: font_display: 'swap' }}

  #ContactPanel-{{ section.id }} {
    --cp-aside-background: {{ aside_background }};
    --cp-aside-text: {{ aside_text }};
    --cp-panel-background: {{ panel_background }};
    --cp-text: {{ text_color }};
    --cp-input-background: {{ input_background }};
    --cp-placeholder: {{ placeholder_color }};
    --cp-button: {{ button_color }};
    --cp-button-hover-text: {{ button_hover_text }};
    --cp-button-font: {{ settings.type_button_font.family }}, {{ settings.type_button_font.fallback_families }};
    --cp-button-weight: {{ settings.type_button_font.weight }};
    --color-input-background: {{ input_background }};
    --color-input-text: {{ text_color }};
    --color-input-border: transparent;
  }
{%- endstyle -%}

<div
  class="contact-panel"
  id="ContactPanel-{{ section.id }}"
>
  <div class="contact-panel__backdrop" aria-hidden="true">
    {%- if background_image != blank -%}
      {{
        background_image
        | image_url: width: 2400
        | image_tag:
          class: 'contact-panel__backdrop-img',
          widths: '750, 1100, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'lazy',
          alt: ''
      }}
    {%- endif -%}
  </div>

  <div class="contact-panel__card">
    <div class="contact-panel__aside">
      <div class="contact-panel__aside-inner">
        {%- if show_paw_icons -%}
          <span class="contact-panel__paw">
            {%- render 'icon-paw' -%}
          </span>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 class="contact-panel__heading">{{ heading }}</h2>
        {%- endif -%}

        {%- if show_paw_icons -%}
          <span class="contact-panel__paw">
            {%- render 'icon-paw' -%}
          </span>
        {%- endif -%}
      </div>
    </div>

    <div class="contact-panel__main">
      {%- if inset_image != blank -%}
        <div class="contact-panel__inset">
          {{
            inset_image
            | image_url: width: 420
            | image_tag:
              class: 'contact-panel__inset-img',
              widths: '166, 210, 332, 420',
              sizes: '(min-width: 750px) 105px, 83px',
              loading: 'lazy',
              alt: inset_alt
          }}
        </div>
      {%- endif -%}

      {%- form 'contact', id: form_id, class: 'contact-panel__form' -%}
        <input type="hidden" name="contact[id]" value="{{ form_id }}">

        {% liquid
          assign form_matches = false
          if form.id == form_id or form.id == blank
            assign form_matches = true
          endif
        %}

        <div class="contact-panel__copy">
          {%- if intro != blank -%}
            <p class="contact-panel__intro">{{ intro }}</p>
          {%- endif -%}

          {%- if form.errors and form_matches -%}
            <div
              id="ContactPanel-Error-{{ section.id }}"
              class="contact-panel__message contact-panel__message--error"
              tabindex="-1"
              autofocus
            >
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? and form_matches -%}
            <div
              id="ContactPanel-Success-{{ section.id }}"
              class="contact-panel__message contact-panel__message--success"
              tabindex="-1"
              autofocus
            >
              {{ 'blocks.contact_form.post_success' | t }}
            </div>
          {%- endif -%}

          <div class="contact-panel__fields">
            <label class="visually-hidden" for="ContactPanel-Name-{{ section.id }}">
              {{- 'blocks.contact_form.name' | t -}}
            </label>
            <input
              id="ContactPanel-Name-{{ section.id }}"
              class="contact-panel__input"
              type="text"
              name="contact[name]"
              autocomplete="name"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              required
              aria-required="true"
              placeholder="{{ placeholder_name | escape }}"
            >

            <label class="visually-hidden" for="ContactPanel-Email-{{ section.id }}">
              {{- 'blocks.contact_form.email' | t -}}
            </label>
            <input
              id="ContactPanel-Email-{{ section.id }}"
              class="contact-panel__input"
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              required
              aria-required="true"
              {% if form.errors contains 'email' and form_matches %}
                aria-invalid="true"
                aria-describedby="ContactPanel-Error-{{ section.id }}"
              {% endif %}
              placeholder="{{ placeholder_email | escape }}"
            >

            <label class="visually-hidden" for="ContactPanel-Phone-{{ section.id }}">
              {{- 'blocks.contact_form.phone' | t -}}
            </label>
            <input
              id="ContactPanel-Phone-{{ section.id }}"
              class="contact-panel__input"
              type="tel"
              name="contact[phone]"
              autocomplete="tel"
              pattern="[0-9\-]*"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="{{ placeholder_phone | escape }}"
            >

            <label class="visually-hidden" for="ContactPanel-Body-{{ section.id }}">
              {{- 'blocks.contact_form.comment' | t -}}
            </label>
            <textarea
              id="ContactPanel-Body-{{ section.id }}"
              class="contact-panel__input contact-panel__input--textarea"
              name="contact[body]"
              rows="3"
              placeholder="{{ placeholder_message | escape }}"
            >{{ form.body }}</textarea>
          </div>
        </div>

        <button type="submit" class="contact-panel__submit">
          <span>{{ button_label }}</span>
          {%- if show_button_icon -%}
            <span class="contact-panel__submit-icon">
              {%- render 'icon-arrow-right-long' -%}
            </span>
          {%- endif -%}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .contact-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
    padding: 3.75rem 0.6875rem;
    color: var(--cp-text, #242027);
  }

  .contact-panel__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .contact-panel__backdrop-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .contact-panel__card {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    width: 100%;
    max-width: 23rem;
    margin-inline: auto;
  }

  .contact-panel__aside {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    padding: 1.25rem;
    background-color: var(--cp-aside-background, #321c41);
    color: var(--cp-aside-text, #f8f5fb);
  }

  .contact-panel__aside-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    width: 100%;
    height: 100%;
  }

  .contact-panel__paw {
    display: block;
    flex-shrink: 0;
    width: 1.6875rem;
    height: 1.5175rem;
    color: inherit;
  }

  .contact-panel__paw svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .contact-panel__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 2rem;
    letter-spacing: 0;
    text-align: center;
    color: inherit;
  }

  .contact-panel__main {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.25rem 0;
    background-color: var(--cp-panel-background, #e8dff1);
  }

  .contact-panel__inset {
    align-self: flex-end;
    flex-shrink: 0;
    width: 5.1875rem;
    height: 6.3125rem;
    overflow: hidden;
  }

  .contact-panel__inset-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .contact-panel__form {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 1.25rem;
    width: 100%;
    padding-block: 1.875rem;
  }

  .contact-panel__copy {
    display: flex;
    flex-direction: column;
    gap: 0.9375rem;
    width: 100%;
  }

  .contact-panel__intro {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.375rem;
    color: var(--cp-text, #242027);
  }

  .contact-panel__fields {
    display: flex;
    flex-direction: column;
    gap: 0.6875rem;
    width: 100%;
  }

  .contact-panel__input {
    width: 100%;
    height: 2.875rem;
    padding: 0.75rem 1rem;
    border: 0;
    border-radius: 0.3125rem;
    background-color: var(--cp-input-background, #f4eef9);
    color: var(--cp-text, #242027);
    font-family: var(--font-body--family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.375rem;
  }

  .contact-panel__input:hover,
  .contact-panel__input:focus,
  .contact-panel__input:focus-visible,
  .contact-panel__input:active,
  .contact-panel__input:autofill {
    background-color: var(--cp-input-background, #f4eef9);
    color: var(--cp-text, #242027);
  }

  .contact-panel__input::placeholder {
    color: var(--cp-placeholder, #918d95);
    opacity: 1;
  }

  .contact-panel__input:focus-visible {
    outline: 0.125rem solid var(--cp-button, #321c41);
    outline-offset: 0.125rem;
  }

  .contact-panel__input--textarea {
    height: 6rem;
    min-height: 5rem;
    resize: vertical;
  }

  .contact-panel__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 2.875rem;
    padding: 0.75rem 1.5rem;
    border: 0.03125rem solid var(--cp-button, #321c41);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--cp-button, #321c41);
    font-family: var(--cp-button-font, var(--font-body--family));
    font-size: 1rem;
    font-weight: var(--cp-button-weight, 400);
    line-height: 1.4;
    letter-spacing: 0.03rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .contact-panel__submit:hover {
    background-color: var(--cp-aside-background, #321c41);
    color: var(--cp-button-hover-text, #fffdf8);
  }

  .contact-panel__submit:focus-visible {
    outline: 0.125rem solid var(--cp-button, #321c41);
    outline-offset: 0.125rem;
  }

  .contact-panel__submit-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
  }

  .contact-panel__submit-icon svg {
    width: 100%;
    height: auto;
  }

  .contact-panel__message {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.3;
  }

  .contact-panel__message--error {
    color: #9b1c1c;
  }

  @media screen and (min-width: 750px) {
    .contact-panel {
      padding: 4.375rem 1.875rem;
    }

    .contact-panel__card {
      flex-direction: row;
      gap: 0;
      max-width: 75rem;
    }

    .contact-panel__aside {
      flex: 1 1 50%;
      aspect-ratio: auto;
      min-height: 38.125rem;
      padding: 3rem 5.5rem 1.4375rem;
    }

    .contact-panel__aside-inner {
      height: 31.5rem;
      max-width: 26.5rem;
    }

    .contact-panel__heading {
      font-size: 2rem;
      line-height: 1.12;
      letter-spacing: 0.002rem;
    }

    .contact-panel__main {
      flex: 1 1 50%;
      padding: 7.5rem 1.875rem 0;
    }

    .contact-panel__inset {
      position: absolute;
      top: 1.875rem;
      right: 1.875rem;
      width: 6.5625rem;
      height: 8.6875rem;
    }

    .contact-panel__intro {
      max-width: 25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact Panel",
  "tag": "section",
  "class": "contact-panel-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WE WOULD LOVE TO HEAR FROM YOU"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Tell us about an order, a scene, a gift, or just to say hello."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send message"
    },
    {
      "type": "checkbox",
      "id": "show_button_icon",
      "label": "Show button arrow icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_paw_icons",
      "label": "Show paw icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Form placeholders"
    },
    {
      "type": "text",
      "id": "placeholder_name",
      "label": "Name placeholder",
      "default": "Your name *"
    },
    {
      "type": "text",
      "id": "placeholder_email",
      "label": "Email placeholder",
      "default": "Your email *"
    },
    {
      "type": "text",
      "id": "placeholder_phone",
      "label": "Phone placeholder",
      "default": "Your phone number"
    },
    {
      "type": "text",
      "id": "placeholder_message",
      "label": "Message placeholder",
      "default": "Tell us more..."
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "inset_image",
      "label": "Inset image"
    },
    {
      "type": "text",
      "id": "inset_image_alt",
      "label": "Inset image alt text",
      "default": "Pup resting on a bench with a picnic basket"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "aside_background",
      "label": "Heading panel background",
      "default": "#321C41"
    },
    {
      "type": "color",
      "id": "aside_text",
      "label": "Heading panel text",
      "default": "#F8F5FB"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Form panel background",
      "default": "#E8DFF1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Form panel text",
      "default": "#242027"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "#F4EEF9"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder color",
      "default": "#918D95"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#321C41"
    },
    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Button text on hover",
      "default": "#FFFDF8",
      "info": "The button fills with the heading panel background on hover."
    }
  ],
  "presets": [
    {
      "name": "Contact Panel",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
