{%- liquid
  assign background_color = section.settings.background_color | default: '#C8AFDE'
  assign text_color = section.settings.text_color | default: '#321C41'

  assign is_boxed = false
  if section.settings.section_width == 'boxed'
    assign is_boxed = true
  endif

  assign mobile_full_width = section.settings.mobile_full_width

  assign corner_radius = 0
  if is_boxed
    assign corner_radius = section.settings.border_radius
  endif
  assign corner_radius_rem = corner_radius | divided_by: 16.0

  assign dots_offset_bottom_rem = section.settings.dots_offset_bottom_mobile | divided_by: 16.0

  assign show_dots = false
  if section.blocks.size > 1
    assign show_dots = true
  endif

  assign pin_dots = false
  if show_dots and section.settings.dots_pin_bottom
    assign pin_dots = true
  endif
-%}

<script
  src="{{ 'trust-strip.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'contrast-override',
  background_color: background_color,
  text_color: text_color,
  section_id: section.id,
  skip_contrast: true
%}

{%- unless is_boxed -%}
  <div
    class="section-background color-custom-{{ section.id }}"
    style="background-color: {{ background_color }};"
  ></div>
{%- endunless -%}

<trust-strip-component
  class="
    section
    trust-strip
    color-custom-{{ section.id }}
    {% if is_boxed %}
      section--page-width
      trust-strip--boxed
      {% if mobile_full_width %}section--mobile-full-width trust-strip--mobile-full{% endif %}
    {% else %}
      section--full-width
    {% endif %}
    {% if pin_dots %}trust-strip--dots-pinned{% endif %}
  "
  style="
    --trust-strip-bg: {{ background_color }};
    --trust-strip-text: {{ text_color }};
    --trust-strip-radius: {{ corner_radius_rem }}rem;
    --trust-strip-dots-offset-bottom: {{ dots_offset_bottom_rem }}rem;
    {%- if section.settings.dot_active_color != blank %}
      --trust-strip-dot-active: {{ section.settings.dot_active_color }};
    {%- endif %}
    {%- if section.settings.dot_inactive_color != blank %}
      --trust-strip-dot-inactive: {{ section.settings.dot_inactive_color }};
      --trust-strip-dot-inactive-bg: {{ section.settings.dot_inactive_color }};
    {%- endif %}
  "
>
  <div
    class="trust-strip__inner spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <ul
      class="trust-strip__list"
      role="list"
      ref="track"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign icon = block.settings.icon
          assign icon_asset = block.settings.icon_asset
          if icon_asset == blank
            case forloop.index
              when 1
                assign icon_asset = 'trust-strip-icon-brush.svg'
              when 2
                assign icon_asset = 'trust-strip-icon-heart.svg'
              when 3
                assign icon_asset = 'trust-strip-icon-box.svg'
              else
                assign icon_asset = 'trust-strip-icon-brush.svg'
            endcase
          endif
        -%}
        <li
          class="trust-strip__item"
          data-trust-item
          {{ block.shopify_attributes }}
        >
          <div class="trust-strip__icon" aria-hidden="true">
            {%- if icon != blank -%}
              {{
                icon
                | image_url: width: 100
                | image_tag:
                  class: 'trust-strip__icon-img',
                  widths: '50, 100',
                  sizes: '50px',
                  loading: 'lazy',
                  alt: ''
              }}
            {%- else -%}
              <img
                class="trust-strip__icon-img"
                src="{{ icon_asset | asset_url }}"
                alt=""
                width="50"
                height="50"
                loading="lazy"
              >
            {%- endif -%}
          </div>

          <div class="trust-strip__copy">
            {%- if block.settings.title != blank -%}
              <p class="trust-strip__title">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="trust-strip__description">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if show_dots -%}
      <div
        class="trust-strip__dots"
        ref="dots"
        role="tablist"
        aria-label="{{ section.settings.dots_label | default: 'Trust highlights' | escape }}"
      >
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="trust-strip__dot"
            aria-label="Go to highlight {{ forloop.index }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</trust-strip-component>

{% stylesheet %}
  .trust-strip {
    position: relative;
    overflow: hidden;
    color: var(--trust-strip-text, #321c41);
  }

  .trust-strip.trust-strip--boxed {
    --full-page-grid-central-column-width: min(75rem, calc(100% - var(--page-margin) * 2));

    background-color: transparent;
  }

  .trust-strip__inner {
    position: relative;
    overflow: hidden;
    border-radius: var(--trust-strip-radius, 0);
    background-color: var(--trust-strip-bg, #c8afde);
  }

  .trust-strip__list {
    display: flex;
    align-items: center;
    gap: 1.625rem;
    margin: 0;
    padding: 0;
    width: 100%;
    min-width: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
  }

  .trust-strip__list::-webkit-scrollbar {
    display: none;
  }

  .trust-strip__item {
    display: flex;
    flex-direction: column;
    flex: 0 0 100%;
    align-items: center;
    justify-content: center;
    gap: 0.9375rem;
    width: 100%;
    max-width: 100%;
    overflow: clip;
    text-align: center;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .trust-strip__icon {
    position: relative;
    flex-shrink: 0;
    width: 3.125rem;
    height: 3.125rem;
    overflow: clip;
  }

  .trust-strip__icon-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .trust-strip__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    width: 100%;
    color: var(--trust-strip-text, #321c41);
    text-align: center;
    overflow-wrap: break-word;
  }

  .trust-strip__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.2;
    color: inherit;
  }

  .trust-strip__description {
    margin: 0;
    width: 100%;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.25rem;
    color: inherit;
  }

  .trust-strip__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6875rem;
    width: 100%;
    height: 0.4375rem;
    margin: 0.9375rem 0 0;
    padding: 0;
    list-style: none;
  }

  .trust-strip__dot {
    appearance: none;
    display: block;
    flex-shrink: 0;
    width: 0.4375rem;
    height: 0.4375rem;
    margin: 0;
    padding: 0;
    border: 0.03125rem solid var(--trust-strip-dot-inactive, var(--trust-strip-text, #321c41));
    border-radius: 50%;
    background: var(--trust-strip-dot-inactive-bg, transparent);
    cursor: pointer;
  }

  .trust-strip__dot[aria-current='true'] {
    border-color: var(--trust-strip-dot-active, transparent);
    background: var(--trust-strip-dot-active, var(--trust-strip-text, #321c41));
  }

  .trust-strip__dot:focus-visible {
    outline: 0.125rem solid var(--trust-strip-text, #321c41);
    outline-offset: 0.125rem;
  }

  @media screen and (max-width: 749px) {
    .trust-strip--mobile-full .trust-strip__inner {
      border-radius: 0;
    }

    .trust-strip--dots-pinned .trust-strip__dots {
      position: absolute;
      inset-inline: 0;
      bottom: var(--trust-strip-dots-offset-bottom, 0rem);
      width: auto;
      margin: 0;
    }
  }

  @media screen and (min-width: 750px) {
    .trust-strip__list {
      justify-content: space-between;
      gap: 1.5rem;
      overflow: visible;
      scroll-snap-type: none;
    }

    .trust-strip__item {
      flex: 1 1 0;
      width: auto;
      max-width: 20.6875rem;
      scroll-snap-align: none;
      scroll-snap-stop: normal;
    }

    .trust-strip__description {
      max-width: 20.6875rem;
    }

    .trust-strip__dots {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.trust_strip",
  "tag": "section",
  "class": "trust-strip-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "full-width",
          "label": "t:options.full"
        },
        {
          "value": "boxed",
          "label": "Boxed"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "checkbox",
      "id": "mobile_full_width",
      "label": "Full width on mobile",
      "info": "Keeps the strip edge to edge below 750px. Corners stay square while full width.",
      "default": true,
      "visible_if": "{{ section.settings.section_width == 'boxed' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.section_width == 'boxed' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#C8AFDE"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#321C41"
    },
    {
      "type": "header",
      "content": "Carousel dots"
    },
    {
      "type": "text",
      "id": "dots_label",
      "label": "Carousel dots label",
      "default": "Trust highlights"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active dot color",
      "info": "Leave empty to use the text color.",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "dot_inactive_color",
      "label": "Inactive dot color",
      "info": "Leave empty to keep the outlined dots.",
      "placeholder": "t:settings.default"
    },
    {
      "type": "checkbox",
      "id": "dots_pin_bottom",
      "label": "Pin dots to the bottom on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "dots_offset_bottom_mobile",
      "label": "Dots offset from bottom",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 20,
      "visible_if": "{{ section.settings.dots_pin_bottom }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "use_mobile_padding",
      "label": "Use mobile padding",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "Mobile top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 18,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "Mobile bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-inline-start-mobile",
      "label": "Mobile left",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 25,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding-inline-end-mobile",
      "label": "Mobile right",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 25,
      "visible_if": "{{ section.settings.use_mobile_padding }}"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "icon_asset",
          "label": "Icon asset fallback",
          "info": "Filename in the assets folder. Used when no icon is selected."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "No Risk of a Bad Fit"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Free preview first, then up to three free adjustments. Still off? Try a new photo."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.trust_strip",
      "category": "t:categories.other_sections",
      "settings": {
        "section_width": "full-width",
        "mobile_full_width": true,
        "border_radius": 0,
        "background_color": "#C8AFDE",
        "text_color": "#321C41",
        "dots_pin_bottom": false,
        "dots_offset_bottom_mobile": 20,
        "padding-block-start": 40,
        "padding-block-end": 40,
        "padding-inline-start": 120,
        "padding-inline-end": 120,
        "use_mobile_padding": true,
        "padding-block-start-mobile": 18,
        "padding-block-end-mobile": 40,
        "padding-inline-start-mobile": 25,
        "padding-inline-end-mobile": 25
      },
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon_asset": "trust-strip-icon-brush.svg",
            "title": "No Risk of a Bad Fit",
            "description": "Free preview first, then up to three free adjustments. Still off? Try a new photo."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon_asset": "trust-strip-icon-heart.svg",
            "title": "Real Humans Who Love Dogs Too",
            "description": "Questions about a scene, a photo, or an order? Reach us anytime by email or live chat."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon_asset": "trust-strip-icon-box.svg",
            "title": "Worldwide Delivery",
            "description": "We ship portraits globally with fully tracked shipping methods. Free shipping on all orders over $100!"
          }
        }
      ]
    }
  ]
}
{% endschema %}
