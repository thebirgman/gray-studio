{%- liquid
  assign heading = section.settings.heading
  assign heading_accent = section.settings.heading_accent
  assign description = section.settings.description
  assign button_primary_label = section.settings.button_primary_label
  assign button_primary_link = section.settings.button_primary_link
  assign button_secondary_label = section.settings.button_secondary_label
  assign button_secondary_link = section.settings.button_secondary_link
  assign social_proof = section.settings.social_proof
  assign show_stars = section.settings.show_stars
  assign star_count = section.settings.star_count | default: 5
  assign background_color = section.settings.background_color | default: '#FFFDF8'
  assign text_color = section.settings.text_color | default: '#242027'
  assign accent_color = section.settings.accent_color | default: '#CE6911'
  assign brand_color = section.settings.brand_color | default: '#321C41'
  assign muted_color = section.settings.muted_color | default: '#605C64'
  assign badge_bg = section.settings.badge_background | default: '#FAF8F0'
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign desktop_asset = section.settings.desktop_image_asset | default: 'hero-pups-desktop.png'
  assign mobile_asset = section.settings.mobile_image_asset | default: 'hero-pups-mobile.png'
  assign image_alt = section.settings.image_alt | default: heading
  assign badge_1_line_1 = section.settings.badge_1_line_1
  assign badge_1_line_2 = section.settings.badge_1_line_2
  assign badge_1_icon_image = section.settings.badge_1_icon
  assign badge_1_icon_asset = section.settings.badge_1_icon_asset | default: 'pups-badge-preview-icon.svg'
  assign badge_2_line_1 = section.settings.badge_2_line_1
  assign badge_2_line_2 = section.settings.badge_2_line_2
  assign badge_2_icon_image = section.settings.badge_2_icon
  assign badge_2_icon_asset = section.settings.badge_2_icon_asset | default: 'pups-badge-style-icon.svg'
  assign show_badge_1 = false
  assign show_badge_2 = false
  if badge_1_line_1 != blank or badge_1_line_2 != blank
    assign show_badge_1 = true
  endif
  if badge_2_line_1 != blank or badge_2_line_2 != blank
    assign show_badge_2 = true
  endif
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{% render 'contrast-override',
  background_color: background_color,
  text_color: text_color,
  section_id: section.id,
  skip_contrast: true
%}

<div
  class="section-background color-custom-{{ section.id }}"
  style="background-color: {{ background_color }};"
></div>

<div
  class="hero-banner section color-custom-{{ section.id }}"
  id="HeroBanner-{{ section.id }}"
  style="
    --hb-bg: {{ background_color }};
    --hb-text: {{ text_color }};
    --hb-accent: {{ accent_color }};
    --hb-brand: {{ brand_color }};
    --hb-muted: {{ muted_color }};
    --hb-badge-bg: {{ badge_bg }};
    --hb-on-brand: #fefefd;
    --hb-badge-secondary: #918d95;
    --hb-divider: #8b7c96;
  "
>
  <div class="hero-banner__media force-full-width">
    <div class="hero-banner__media-stage">
      <picture aria-hidden="{% if image_alt == blank %}true{% else %}false{% endif %}">
      {%- if mobile_image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ mobile_image | image_url: width: 750 }} 750w,
            {{ mobile_image | image_url: width: 1100 }} 1100w
          "
          sizes="100vw"
        >
      {%- else -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ mobile_asset | asset_url }}"
        >
      {%- endif -%}

      {%- if desktop_image != blank -%}
        {{
          desktop_image
          | image_url: width: 2880
          | image_tag:
            class: 'hero-banner__img',
            widths: '1200, 1600, 2000, 2400, 2880',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: fetch_priority,
            alt: image_alt
        }}
      {%- else -%}
        <img
          class="hero-banner__img"
          src="{{ desktop_asset | asset_url }}"
          alt="{{ image_alt | escape }}"
          width="1440"
          height="700"
          loading="eager"
          {% if fetch_priority == 'high' %}
            fetchpriority="high"
          {% endif %}
        >
      {%- endif -%}
    </picture>
    </div>
  </div>

  {%- if show_badge_1 or show_badge_2 -%}
    <div class="hero-banner__overlays force-full-width">
      <div class="hero-banner__media-stage">
        {%- if show_badge_1 -%}
          <div class="hero-banner__badge hero-banner__badge--preview">
            <div class="hero-banner__badge-icon" aria-hidden="true">
              {%- if badge_1_icon_image != blank -%}
                {{
                  badge_1_icon_image
                  | image_url: width: 120
                  | image_tag:
                    class: 'hero-banner__badge-icon-img',
                    widths: '40, 80, 120',
                    sizes: '41px',
                    alt: '',
                    loading: 'lazy'
                }}
              {%- else -%}
                <img
                  class="hero-banner__badge-icon-img"
                  src="{{ badge_1_icon_asset | asset_url }}"
                  alt=""
                  width="41"
                  height="35"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
            <div class="hero-banner__badge-copy">
              {%- if badge_1_line_1 != blank -%}
                <p class="hero-banner__badge-line hero-banner__badge-line--primary">{{ badge_1_line_1 }}</p>
              {%- endif -%}
              {%- if badge_1_line_2 != blank -%}
                <p class="hero-banner__badge-line hero-banner__badge-line--secondary">{{ badge_1_line_2 }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if show_badge_2 -%}
          <div class="hero-banner__badge hero-banner__badge--style">
            <div class="hero-banner__badge-icon" aria-hidden="true">
              {%- if badge_2_icon_image != blank -%}
                {{
                  badge_2_icon_image
                  | image_url: width: 120
                  | image_tag:
                    class: 'hero-banner__badge-icon-img',
                    widths: '40, 80, 120',
                    sizes: '36px',
                    alt: '',
                    loading: 'lazy'
                }}
              {%- else -%}
                <img
                  class="hero-banner__badge-icon-img"
                  src="{{ badge_2_icon_asset | asset_url }}"
                  alt=""
                  width="35"
                  height="36"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
            <div class="hero-banner__badge-copy">
              {%- if badge_2_line_1 != blank -%}
                <p class="hero-banner__badge-line hero-banner__badge-line--primary">{{ badge_2_line_1 }}</p>
              {%- endif -%}
              {%- if badge_2_line_2 != blank -%}
                <p class="hero-banner__badge-line hero-banner__badge-line--secondary">{{ badge_2_line_2 }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="hero-banner__content">
    <div class="hero-banner__intro">
      <div class="hero-banner__copy">
        {%- if heading != blank or heading_accent != blank -%}
          <h1 class="hero-banner__heading">
            {%- if heading != blank -%}
              <span class="hero-banner__heading-main">{{ heading }}</span>
            {%- endif -%}
            {%- if heading_accent != blank -%}
              <span class="hero-banner__heading-accent">{{ heading_accent }}</span>
            {%- endif -%}
          </h1>
        {%- endif -%}

        {%- if description != blank -%}
          <p class="hero-banner__description">{{ description }}</p>
        {%- endif -%}
      </div>

      {%- if button_primary_label != blank or button_secondary_label != blank -%}
        <div class="hero-banner__actions">
          {%- if button_primary_label != blank -%}
            <a
              class="hero-banner__button hero-banner__button--primary"
              {% if button_primary_link != blank %}
                href="{{ button_primary_link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              {{ button_primary_label }}
            </a>
          {%- endif -%}

          {%- if button_secondary_label != blank -%}
            <a
              class="hero-banner__button hero-banner__button--secondary"
              {% if button_secondary_link != blank %}
                href="{{ button_secondary_link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              {{ button_secondary_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if show_stars or social_proof != blank -%}
      <div class="hero-banner__social">
        {%- if show_stars -%}
          <div class="hero-banner__stars" aria-hidden="true">
            {%- for i in (1..star_count) -%}
              <span class="hero-banner__star">
                <img
                  class="hero-banner__star-img"
                  src="{{ 'hero-banner-star.svg' | asset_url }}"
                  alt=""
                  width="13"
                  height="13"
                  loading="lazy"
                >
                <img
                  class="hero-banner__star-img hero-banner__star-img--fill"
                  src="{{ 'hero-banner-star-fill.svg' | asset_url }}"
                  alt=""
                  width="13"
                  height="13"
                  loading="lazy"
                >
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if social_proof != blank -%}
          <p class="hero-banner__social-text">{{ social_proof }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .hero-banner {
    --hb-media-width: 1440;
    --hb-media-height: 700;
    --hb-media-pos-x: 70%;
    --hb-media-pos-y: 50%;
    min-height: 49.75rem;
    overflow: hidden;
    color: var(--hb-text, #242027);
  }

  .hero-banner__media {
    grid-column: 1 / -1;
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    container-type: size;
    pointer-events: none;
  }

  .hero-banner__media-stage {
    position: absolute;
    width: max(100cqw, calc(100cqh * var(--hb-media-width) / var(--hb-media-height)));
    height: max(100cqh, calc(100cqw * var(--hb-media-height) / var(--hb-media-width)));
    left: var(--hb-media-pos-x);
    top: var(--hb-media-pos-y);
    translate: calc(-1 * var(--hb-media-pos-x)) calc(-1 * var(--hb-media-pos-y));
    container-type: size;
    container-name: hero-stage;
  }

  .hero-banner__overlays {
    grid-column: 1 / -1;
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    container-type: size;
    pointer-events: none;
  }

  .hero-banner__media-stage picture,
  .hero-banner__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-banner__media-stage picture {
    position: absolute;
    inset: 0;
  }

  .hero-banner__img {
    object-fit: cover;
    object-position: center;
  }

  .hero-banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 21.25rem;
    margin: 0 auto;
    padding: calc(
        (var(--header-height, 5.5rem) * var(--transparent-header-offset-boolean, 0)) + 1rem
      )
      0 0;
    text-align: center;
  }

  .hero-banner__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
    width: 100%;
  }

  .hero-banner__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3125rem;
    width: 100%;
  }

  .hero-banner__heading {
    display: flex;
    flex-direction: column;
    margin: 0;
    width: 100%;
    font-family: var(--font-heading--family);
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 2.75rem;
    letter-spacing: -0.0036px;
    color: var(--hb-text, #242027);
  }

  .hero-banner__heading-main,
  .hero-banner__heading-accent {
    display: block;
  }

  .hero-banner__heading-accent {
    font-style: italic;
    color: var(--hb-accent, #ce6911);
  }

  .hero-banner__description {
    margin: 0;
    width: 100%;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.25rem;
    color: var(--hb-text, #242027);
  }

  .hero-banner__actions {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: center;
    gap: 0.9375rem;
    width: 100%;
  }

  .hero-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 0;
    min-height: 2.875rem;
    padding: 0.75rem 0.75rem;
    border-radius: 0.25rem;
    font-family: var(--font-button--family, var(--font-body--family));
    font-size: 1rem;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .hero-banner__button--primary {
    border: 0.5px solid var(--hb-brand, #321c41);
    background-color: var(--hb-brand, #321c41);
    color: var(--hb-on-brand, #fefefd);
    font-weight: 500;
  }

  .hero-banner__button--primary:hover {
    background-color: color-mix(in srgb, var(--hb-brand, #321c41) 88%, white);
  }

  .hero-banner__button--secondary {
    border: 0.5px solid var(--hb-brand, #321c41);
    background: transparent;
    color: var(--hb-brand, #321c41);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.03em;
  }

  .hero-banner__button--secondary:hover {
    background-color: var(--hb-brand, #321c41);
    color: var(--hb-on-brand, #fefefd);
  }

  .hero-banner__button[aria-disabled='true'] {
    pointer-events: none;
  }

  .hero-banner__button:focus-visible {
    outline: 2px solid var(--hb-brand, #321c41);
    outline-offset: 2px;
  }

  .hero-banner__social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: 100%;
    padding-top: 0.75rem;
    border-top: 1px solid var(--hb-divider, #8b7c96);
  }

  .hero-banner__stars {
    display: flex;
    align-items: center;
    gap: 0.3125rem;
    flex-shrink: 0;
  }

  .hero-banner__star {
    position: relative;
    display: block;
    width: 0.8125rem;
    height: 0.8125rem;
    overflow: clip;
  }

  .hero-banner__star-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-banner__social-text {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.4375rem;
    font-weight: 400;
    line-height: 0.9375rem;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--hb-muted, #605c64);
    white-space: nowrap;
  }

  .hero-banner__badge {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: calc(11 / 1440 * 100cqw);
    padding: calc(11 / 700 * 100cqh) calc(15 / 1440 * 100cqw);
    border-radius: calc(14 / 1440 * 100cqw);
    background-color: var(--hb-badge-bg, #faf8f0);
    box-shadow: 0 14px 34px -14px rgba(58, 55, 51, 0.4);
    pointer-events: none;
  }

  .hero-banner__badge--preview {
    left: calc(740 / 1440 * 100%);
    top: calc(208 / 700 * 100%);
    width: calc(193 / 1440 * 100%);
  }

  .hero-banner__badge--style {
    left: calc(1164 / 1440 * 100%);
    top: calc(402 / 700 * 100%);
    width: calc(201 / 1440 * 100%);
    box-shadow: 0 14px 17px rgba(58, 55, 51, 0.4);
  }

  .hero-banner__badge-icon {
    flex-shrink: 0;
    overflow: clip;
  }

  .hero-banner__badge--preview .hero-banner__badge-icon {
    width: calc(40.54 / 1440 * 100cqw);
    height: calc(34.49 / 1440 * 100cqw);
  }

  .hero-banner__badge--style .hero-banner__badge-icon {
    width: calc(35.2 / 1440 * 100cqw);
    height: calc(36 / 1440 * 100cqw);
  }

  .hero-banner__badge-icon img,
  .hero-banner__badge-icon-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hero-banner__badge-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .hero-banner__badge-line {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: calc(7 / 1440 * 100cqw);
    font-weight: 400;
    line-height: calc(15 / 1440 * 100cqw);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero-banner__badge-line--primary {
    color: var(--hb-text, #242027);
  }

  .hero-banner__badge-line--secondary {
    margin-top: calc(-2 / 1440 * 100cqw);
    color: var(--hb-badge-secondary, #918d95);
  }

  @media screen and (max-width: 749px) {
    .hero-banner {
      min-height: 100svh;
      grid-template-rows: auto minmax(22.5rem, 1fr);
    }

    .hero-banner__media {
      grid-row: 1 / -1;
    }

    .hero-banner__media .hero-banner__media-stage {
      width: 100%;
      height: 100%;
      left: 0;
      top: 0;
      translate: none;
    }

    .hero-banner__img {
      object-position: center bottom;
    }

    .hero-banner__overlays {
      position: relative;
      inset: auto;
      grid-column: 1 / -1;
      grid-row: 2;
      min-height: 22.5rem;
      z-index: 2;
    }

    .hero-banner__overlays .hero-banner__media-stage {
      position: absolute;
      inset: 0;
      width: auto;
      height: auto;
      min-height: 0;
      left: 0;
      top: 0;
      translate: none;
    }

    .hero-banner__content {
      grid-row: 1;
      grid-column: 1 / -1;
      max-width: none;
      padding: calc(
          (var(--header-height, 6rem) * var(--transparent-header-offset-boolean, 0)) + 1rem
        )
        1.5625rem 0;
    }

    .hero-banner__button {
      white-space: nowrap;
    }

    .hero-banner__badge {
      gap: 0.375rem;
      padding: 0.6875rem 0.9375rem;
      border-radius: 0.625rem;
    }

    .hero-banner__badge--preview {
      top: 0.75rem;
      left: 0.8125rem;
      width: 10.9375rem;
    }

    .hero-banner__badge--style {
      top: auto;
      left: auto;
      right: 1.125rem;
      bottom: 1.3125rem;
      width: 11.9375rem;
    }

    .hero-banner__badge--preview .hero-banner__badge-icon {
      width: 1.727rem;
      height: 1.47rem;
    }

    .hero-banner__badge--style .hero-banner__badge-icon {
      width: 1.833rem;
      height: 1.875rem;
    }

    .hero-banner__badge-line {
      font-size: 0.4375rem;
      line-height: 0.9375rem;
    }

    .hero-banner__badge-line--secondary {
      margin-top: -0.125rem;
    }
  }

  @media screen and (min-width: 750px) {
    .hero-banner {
      min-height: 43.75rem;
    }

    .hero-banner__content {
      align-items: flex-start;
      gap: 2.5rem;
      max-width: 25.4375rem;
      margin: 0;
      padding: calc(
          (var(--header-height, 6rem) * var(--transparent-header-offset-boolean, 0)) + 4.25rem
        )
        0 3rem;
      text-align: left;
    }

    .hero-banner__intro {
      align-items: flex-start;
      gap: 1.5625rem;
    }

    .hero-banner__copy {
      align-items: flex-start;
    }

    .hero-banner__heading {
      font-size: 3.5625rem;
      line-height: 4.1875rem;
      letter-spacing: -0.0057px;
    }

    .hero-banner__description {
      font-size: 1rem;
      line-height: 1.375rem;
    }

    .hero-banner__actions {
      justify-content: flex-start;
      width: auto;
    }

    .hero-banner__button {
      flex: 0 0 auto;
      padding: 0.75rem 1.5rem;
    }

    .hero-banner__social {
      justify-content: flex-start;
      height: 3.3125rem;
      padding-top: 0;
      align-items: flex-end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "hero-banner-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Here begins the portrait of your"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "default": "Best Friend"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Upload one photo of your pup. Choose a destination: Paris, Provence, the Italian Lakes, and more. See the finished portrait free before you ever spend a cent."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "Primary button label",
      "default": "Start free preview"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Secondary button label",
      "default": "See how it works"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Social proof"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "range",
      "id": "star_count",
      "label": "Number of stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
