{%- liquid
  assign heading = section.settings.heading
  assign heading_accent = section.settings.heading_accent
  assign description = section.settings.description
  assign button_primary_label = section.settings.button_primary_label
  assign button_primary_link = section.settings.button_primary_link
  assign button_secondary_label = section.settings.button_secondary_label
  assign button_secondary_link = section.settings.button_secondary_link
  assign social_proof = section.settings.social_proof
  assign show_stars = section.settings.show_stars
  assign star_count = section.settings.star_count | default: 5
  assign background_color = section.settings.background_color | default: '#FFFDF8'
  assign text_color = section.settings.text_color | default: '#242027'
  assign accent_color = section.settings.accent_color | default: '#CE6911'
  assign brand_color = section.settings.brand_color | default: '#321C41'
  assign muted_color = section.settings.muted_color | default: '#605C64'
  assign badge_bg = section.settings.badge_background | default: '#FAF8F0'
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign desktop_asset = section.settings.desktop_image_asset | default: 'hero-pups-desktop.png'
  assign mobile_asset = section.settings.mobile_image_asset | default: 'hero-pups-mobile.png'
  assign image_alt = section.settings.image_alt | default: heading
  assign badge_1_line_1 = section.settings.badge_1_line_1
  assign badge_1_line_2 = section.settings.badge_1_line_2
  assign badge_1_icon = section.settings.badge_1_icon_asset | default: 'pups-badge-preview-icon.svg'
  assign badge_2_line_1 = section.settings.badge_2_line_1
  assign badge_2_line_2 = section.settings.badge_2_line_2
  assign badge_2_icon = section.settings.badge_2_icon_asset | default: 'pups-badge-style-icon.svg'
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{% render 'contrast-override',
  background_color: background_color,
  text_color: text_color,
  section_id: section.id,
  skip_contrast: true
%}

<div
  class="section-background color-custom-{{ section.id }}"
  style="background-color: {{ background_color }};"
></div>

<div
  class="hero-banner section color-custom-{{ section.id }}"
  id="HeroBanner-{{ section.id }}"
  style="
    --hb-bg: {{ background_color }};
    --hb-text: {{ text_color }};
    --hb-accent: {{ accent_color }};
    --hb-brand: {{ brand_color }};
    --hb-muted: {{ muted_color }};
    --hb-badge-bg: {{ badge_bg }};
    --hb-on-brand: #fefefd;
    --hb-badge-secondary: #918d95;
    --hb-divider: #8b7c96;
  "
>
  <div class="hero-banner__media force-full-width" aria-hidden="{% if image_alt == blank %}true{% else %}false{% endif %}">
    <picture>
      {%- if mobile_image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ mobile_image | image_url: width: 750 }} 750w,
            {{ mobile_image | image_url: width: 1100 }} 1100w
          "
          sizes="100vw"
        >
      {%- else -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ mobile_asset | asset_url }}"
        >
      {%- endif -%}

      {%- if desktop_image != blank -%}
        {{
          desktop_image
          | image_url: width: 2880
          | image_tag:
            class: 'hero-banner__img',
            widths: '1200, 1600, 2000, 2400, 2880',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: fetch_priority,
            alt: image_alt
        }}
      {%- else -%}
        <img
          class="hero-banner__img"
          src="{{ desktop_asset | asset_url }}"
          alt="{{ image_alt | escape }}"
          width="1440"
          height="700"
          loading="eager"
          {% if fetch_priority == 'high' %}
            fetchpriority="high"
          {% endif %}
        >
      {%- endif -%}
    </picture>
  </div>

  <div class="hero-banner__content">
    <div class="hero-banner__intro">
      <div class="hero-banner__copy">
        {%- if heading != blank or heading_accent != blank -%}
          <h1 class="hero-banner__heading">
            {%- if heading != blank -%}
              <span class="hero-banner__heading-main">{{ heading }}</span>
            {%- endif -%}
            {%- if heading_accent != blank -%}
              <span class="hero-banner__heading-accent">{{ heading_accent }}</span>
            {%- endif -%}
          </h1>
        {%- endif -%}

        {%- if description != blank -%}
          <p class="hero-banner__description">{{ description }}</p>
        {%- endif -%}
      </div>

      {%- if button_primary_label != blank or button_secondary_label != blank -%}
        <div class="hero-banner__actions">
          {%- if button_primary_label != blank -%}
            <a
              class="hero-banner__button hero-banner__button--primary"
              {% if button_primary_link != blank %}
                href="{{ button_primary_link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              {{ button_primary_label }}
            </a>
          {%- endif -%}

          {%- if button_secondary_label != blank -%}
            <a
              class="hero-banner__button hero-banner__button--secondary"
              {% if button_secondary_link != blank %}
                href="{{ button_secondary_link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              {{ button_secondary_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if show_stars or social_proof != blank -%}
      <div class="hero-banner__social">
        {%- if show_stars -%}
          <div class="hero-banner__stars" aria-hidden="true">
            {%- for i in (1..star_count) -%}
              <span class="hero-banner__star">
                <img
                  class="hero-banner__star-img"
                  src="{{ 'hero-banner-star.svg' | asset_url }}"
                  alt=""
                  width="13"
                  height="13"
                  loading="lazy"
                >
                <img
                  class="hero-banner__star-img hero-banner__star-img--fill"
                  src="{{ 'hero-banner-star-fill.svg' | asset_url }}"
                  alt=""
                  width="13"
                  height="13"
                  loading="lazy"
                >
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if social_proof != blank -%}
          <p class="hero-banner__social-text">{{ social_proof }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="hero-banner__overlays force-full-width">
    {%- if badge_1_line_1 != blank or badge_1_line_2 != blank -%}
      <div class="hero-banner__badge hero-banner__badge--preview">
        <div class="hero-banner__badge-icon" aria-hidden="true">
          <img
            src="{{ badge_1_icon | asset_url }}"
            alt=""
            width="41"
            height="35"
            loading="lazy"
          >
        </div>
        <div class="hero-banner__badge-copy">
          {%- if badge_1_line_1 != blank -%}
            <p class="hero-banner__badge-line hero-banner__badge-line--primary">{{ badge_1_line_1 }}</p>
          {%- endif -%}
          {%- if badge_1_line_2 != blank -%}
            <p class="hero-banner__badge-line hero-banner__badge-line--secondary">{{ badge_1_line_2 }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if badge_2_line_1 != blank or badge_2_line_2 != blank -%}
      <div class="hero-banner__badge hero-banner__badge--style">
        <div class="hero-banner__badge-icon" aria-hidden="true">
          <img
            src="{{ badge_2_icon | asset_url }}"
            alt=""
            width="35"
            height="36"
            loading="lazy"
          >
        </div>
        <div class="hero-banner__badge-copy">
          {%- if badge_2_line_1 != blank -%}
            <p class="hero-banner__badge-line hero-banner__badge-line--primary">{{ badge_2_line_1 }}</p>
          {%- endif -%}
          {%- if badge_2_line_2 != blank -%}
            <p class="hero-banner__badge-line hero-banner__badge-line--secondary">{{ badge_2_line_2 }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .hero-banner {
    min-height: 49.75rem;
    overflow: hidden;
    color: var(--hb-text, #242027);
  }

  .hero-banner__media {
    grid-column: 1 / -1;
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-banner__overlays {
    grid-column: 1 / -1;
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .hero-banner__media picture,
  .hero-banner__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-banner__img {
    object-fit: cover;
    object-position: center 85%;
  }

  .hero-banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 21.25rem;
    margin: 0 auto;
    padding: calc(
        (var(--header-height, 5.5rem) * var(--transparent-header-offset-boolean, 0)) + 1rem
      )
      0 0;
    text-align: center;
  }

  .hero-banner__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
    width: 100%;
  }

  .hero-banner__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3125rem;
    width: 100%;
  }

  .hero-banner__heading {
    display: flex;
    flex-direction: column;
    margin: 0;
    width: 100%;
    font-family: var(--font-heading--family);
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 2.75rem;
    letter-spacing: -0.0036px;
    color: var(--hb-text, #242027);
  }

  .hero-banner__heading-main,
  .hero-banner__heading-accent {
    display: block;
  }

  .hero-banner__heading-accent {
    font-style: italic;
    color: var(--hb-accent, #ce6911);
  }

  .hero-banner__description {
    margin: 0;
    width: 100%;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.25rem;
    color: var(--hb-text, #242027);
  }

  .hero-banner__actions {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    justify-content: center;
    gap: 0.9375rem;
    width: 100%;
  }

  .hero-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 0;
    min-height: 2.875rem;
    padding: 0.75rem 0.75rem;
    border-radius: 0.25rem;
    font-family: var(--font-button--family, var(--font-body--family));
    font-size: 1rem;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .hero-banner__button--primary {
    border: 0.5px solid var(--hb-brand, #321c41);
    background-color: var(--hb-brand, #321c41);
    color: var(--hb-on-brand, #fefefd);
    font-weight: 500;
  }

  .hero-banner__button--primary:hover {
    background-color: color-mix(in srgb, var(--hb-brand, #321c41) 88%, white);
  }

  .hero-banner__button--secondary {
    border: 0.5px solid var(--hb-brand, #321c41);
    background: transparent;
    color: var(--hb-brand, #321c41);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.03em;
  }

  .hero-banner__button--secondary:hover {
    background-color: var(--hb-brand, #321c41);
    color: var(--hb-on-brand, #fefefd);
  }

  .hero-banner__button[aria-disabled='true'] {
    pointer-events: none;
  }

  .hero-banner__button:focus-visible {
    outline: 2px solid var(--hb-brand, #321c41);
    outline-offset: 2px;
  }

  .hero-banner__social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: 100%;
    padding-top: 0.75rem;
    border-top: 1px solid var(--hb-divider, #8b7c96);
  }

  .hero-banner__stars {
    display: flex;
    align-items: center;
    gap: 0.3125rem;
    flex-shrink: 0;
  }

  .hero-banner__star {
    position: relative;
    display: block;
    width: 0.8125rem;
    height: 0.8125rem;
    overflow: clip;
  }

  .hero-banner__star-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-banner__social-text {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.4375rem;
    font-weight: 400;
    line-height: 0.9375rem;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--hb-muted, #605c64);
    white-space: nowrap;
  }

  .hero-banner__badge {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.6875rem 0.9375rem;
    border-radius: 0.625rem;
    background-color: var(--hb-badge-bg, #faf8f0);
    box-shadow: 0 14px 34px -14px rgba(58, 55, 51, 0.4);
    pointer-events: none;
  }

  .hero-banner__badge--preview {
    left: 0.8125rem;
    bottom: 18.3125rem;
    width: 10.9375rem;
  }

  .hero-banner__badge--style {
    left: 11.3125rem;
    bottom: 1.3125rem;
    width: 11.9375rem;
    gap: 0.6875rem;
    box-shadow: 0 14px 17px rgba(58, 55, 51, 0.4);
  }

  .hero-banner__badge-icon {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    overflow: clip;
  }

  .hero-banner__badge--preview .hero-banner__badge-icon {
    width: 1.727rem;
    height: 1.47rem;
  }

  .hero-banner__badge--style .hero-banner__badge-icon {
    width: 1.833rem;
    height: 1.875rem;
  }

  .hero-banner__badge-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hero-banner__badge-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .hero-banner__badge-line {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.4375rem;
    font-weight: 400;
    line-height: 0.9375rem;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero-banner__badge-line--primary {
    color: var(--hb-text, #242027);
  }

  .hero-banner__badge-line--secondary {
    margin-top: -0.125rem;
    color: var(--hb-badge-secondary, #918d95);
  }

  @media screen and (min-width: 750px) {
    .hero-banner {
      min-height: 43.75rem;
    }

    .hero-banner__img {
      object-position: 70% center;
    }

    .hero-banner__content {
      align-items: flex-start;
      gap: 2.5rem;
      max-width: 25.4375rem;
      margin: 0;
      padding: calc(
          (var(--header-height, 6rem) * var(--transparent-header-offset-boolean, 0)) + 4.25rem
        )
        0 3rem;
      text-align: left;
    }

    .hero-banner__intro {
      align-items: flex-start;
      gap: 1.5625rem;
    }

    .hero-banner__copy {
      align-items: flex-start;
    }

    .hero-banner__heading {
      font-size: 3.5625rem;
      line-height: 4.1875rem;
      letter-spacing: -0.0057px;
    }

    .hero-banner__description {
      font-size: 1rem;
      line-height: 1.375rem;
    }

    .hero-banner__actions {
      justify-content: flex-start;
      width: auto;
    }

    .hero-banner__button {
      flex: 0 0 auto;
      padding: 0.75rem 1.5rem;
    }

    .hero-banner__social {
      justify-content: flex-start;
      height: 3.3125rem;
      padding-top: 0;
      align-items: flex-end;
    }

    .hero-banner__badge {
      gap: 0.6875rem;
      border-radius: 0.875rem;
    }

    .hero-banner__badge--preview {
      left: clamp(28rem, 51.4vw, 46.25rem);
      bottom: 27.1875rem;
      width: auto;
      min-width: 12.0625rem;
    }

    .hero-banner__badge--style {
      left: clamp(42rem, 80.8vw, 72.75rem);
      bottom: 15rem;
      width: 12.5625rem;
      padding: 0.875rem 0.9375rem;
    }

    .hero-banner__badge--preview .hero-banner__badge-icon {
      width: 2.534rem;
      height: 2.155rem;
    }

    .hero-banner__badge--style .hero-banner__badge-icon {
      width: 2.2rem;
      height: 2.25rem;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .hero-banner__badge--preview {
      left: auto;
      right: 42%;
      bottom: 55%;
    }

    .hero-banner__badge--style {
      left: auto;
      right: 4%;
      bottom: 18%;
    }
  }
{% endstylesheet %}

{% schema %}
